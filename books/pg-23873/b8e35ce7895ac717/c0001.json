{"bookId":"pg-23873","editionId":"b8e35ce7895ac717","chapterId":"c0001","paragraphs":[{"id":"p9c9990d204fe-1","text":"Produced by Christine Zeng and Qi-Ming publishing house"},{"id":"pb4886d27aa6a-1","text":"國風"},{"id":"pa704969b8444-1","text":"周南"},{"id":"p76d6fb148851-1","text":"1.  關睢"},{"id":"pebcf4222ddfd-1","text":"關關雎鳩、在河之洲。"},{"id":"p75909963c288-1","text":"窈宨淑女、君子好逑。"},{"id":"p76a6d807354e-1","text":"參差荇菜、左右流之。"},{"id":"p61103b26af22-1","text":"窈宨淑女、寤寐求之。"},{"id":"p6cb2b3f9fd9e-1","text":"求之不得、寤寐思服。"},{"id":"p14c8658a7c2b-1","text":"悠哉悠哉、輾轉反側。"},{"id":"pb67b07229647-1","text":"參差荇菜、左右采之。"},{"id":"p1bbe9135045e-1","text":"窈宨淑女、琴瑟友之。"},{"id":"p9c60ebc3901f-1","text":"參差荇菜、左右芼之。"},{"id":"p7efb39156925-1","text":"窈宨淑女、 鍾鼓樂之。"},{"id":"pc85b05b402c3-1","text":"2.  葛覃"},{"id":"p8e628ebf1183-1","text":"葛之覃兮、施于中谷。"},{"id":"p2bf8da6fcad8-1","text":"維葉萋萋、黃鳥于飛。"},{"id":"p9dd865660737-1","text":"集于灌木、其鳴喈喈。"},{"id":"p8e628ebf1183-2","text":"葛之覃兮、施于中谷。"},{"id":"p905870d0a6b9-1","text":"維葉莫莫、是刈是濩。"},{"id":"p813d91596ec6-1","text":"為絺為綌、服之無斁。"},{"id":"p0e60563ae94e-1","text":"言告師氏、言告言歸。"},{"id":"p231aa3a2dba3-1","text":"薄污我私、薄澣我衣。"},{"id":"p31bed8920331-1","text":"害澣害否、歸寧父母 。"},{"id":"pa258db0f4567-1","text":"3.   卷耳"},{"id":"p7fc104a53c37-1","text":"采采卷耳、不盈頃筐。"},{"id":"p0cef10e7970e-1","text":"嗟我懷人、寘彼周行。"},{"id":"pe59ff86f5b0b-1","text":"陟彼崔嵬、我馬虺隤。"},{"id":"p1633282b10b1-1","text":"我姑酌彼金罍、維以不永懷。"},{"id":"p585681bca9be-1","text":"陟彼高岡、我馬玄黃。"},{"id":"p4195c23cb189-1","text":"我姑酌彼兕觥、維以不永傷。"},{"id":"p96f85b42c596-1","text":"陟彼砠矣、我馬瘏矣、我僕痡矣、云何吁矣。"},{"id":"p5980d5b4f976-1","text":"4.  樛木"},{"id":"pe3aa6f0cd1a9-1","text":"南有樛木、葛藟纍之。"},{"id":"pc3a6b8c0e072-1","text":"樂只君子、福履綏之。"},{"id":"pd18e3bbd9d08-1","text":"南有樛木、葛藟荒之。"},{"id":"p655e3838675a-1","text":"樂只君子、福履將之。"},{"id":"p38a575ec2fb6-1","text":"南有樛木、葛藟縈之。"},{"id":"p995e53928457-1","text":"樂只君子、福履成之。"},{"id":"p9d4aca7444f8-1","text":"5.   螽斯"},{"id":"p0050e82ac49c-1","text":"螽斯羽、詵詵兮。"},{"id":"p47b64c15eef6-1","text":"宜爾子孫、振振兮。"},{"id":"pe550a6d8e1fe-1","text":"螽斯羽、薨薨兮。"},{"id":"pe4619dd3e33b-1","text":"宜爾子孫、繩繩兮。"},{"id":"p6f79ceb75ef5-1","text":"螽斯羽、揖揖兮。"},{"id":"p4b1f113644b6-1","text":"宜爾子孫、蟄蟄兮。"},{"id":"paf85c1d177fd-1","text":"6.   桃夭"},{"id":"p34ab01b74390-1","text":"桃之夭夭、灼灼其華。"},{"id":"p41caf354cb04-1","text":"之子于歸、宜其家室。"},{"id":"pbbee358db3e5-1","text":"桃之夭夭、有蕡其實。"},{"id":"p9349ab28f91e-1","text":"之子于歸、宜其室家。"},{"id":"pb2ec9e028917-1","text":"桃之夭夭、其葉蓁蓁。"},{"id":"p77061b255c0e-1","text":"之子于歸、宜其家人。"},{"id":"pde1fe5cd0bfd-1","text":"7.  兔罝"},{"id":"pc61b579851ea-1","text":"肅肅兔罝、椓之丁丁。"},{"id":"pc081275ff5c1-1","text":"赳赳武夫、公侯干城。"},{"id":"p60d8344bc375-1","text":"肅肅兔罝、施于中逵。"},{"id":"p375229218cc5-1","text":"赳赳武夫、公侯好仇。"},{"id":"p64ad64ac46a0-1","text":"肅肅兔罝、施于中林。"},{"id":"p522c15aa1a59-1","text":"赳赳武夫、公侯腹心。"},{"id":"pa9df086b8317-1","text":"8.  芣苡"},{"id":"p3fee84a24c04-1","text":"采采芣苡、薄言采之。"},{"id":"p5d377a8d4e09-1","text":"采采芣苡、薄言有之。"},{"id":"pbd6c4424720a-1","text":"采采芣苡、薄言掇之。"},{"id":"ped4393014478-1","text":"采采芣苡、薄言捋之。"},{"id":"p2ea9d3b723c8-1","text":"采采芣苡、薄言袺之。"},{"id":"p9740b2ce9bc8-1","text":"采采芣苡、薄言襭之。"},{"id":"pb2acc835b22a-1","text":"9.  漢廣"},{"id":"p32bf00172f07-1","text":"南有喬木、不可休息。"},{"id":"pa25de9315545-1","text":"漢有游女、不可求思。"},{"id":"p4125e6b0dc67-1","text":"漢之廣矣、不可泳思。"},{"id":"p5b4399143964-1","text":"江之永矣、不可方思。"},{"id":"p1c0517974d26-1","text":"翹翹錯薪、言刈其楚。"},{"id":"pf834726d7e39-1","text":"之子于歸、言秣其馬。"},{"id":"p4125e6b0dc67-2","text":"漢之廣矣、不可泳思。"},{"id":"p5b4399143964-2","text":"江之永矣、不可方思。"},{"id":"pef2510fba30a-1","text":"翹翹錯薪、言刈其蔞 。"},{"id":"p3b2e82d3f505-1","text":"之子于歸、言秣其駒 。"},{"id":"p68829f9dd54c-1","text":"漢之廣矣、不可泳思 。"},{"id":"p465f67ed11f7-1","text":"江之永矣、不可方思 。"},{"id":"pd91939c430ad-1","text":"10.  汝墳"},{"id":"p792dde0d0f89-1","text":"遵彼汝墳、伐其條枚。"},{"id":"p7d81b3e50c2e-1","text":"未見君子、惄如調飢。"},{"id":"p351978b29363-1","text":"遵彼汝墳、伐其條肆。"},{"id":"p7770a05e0c5d-1","text":"既見君子、不我遐棄。"},{"id":"p1e812bb0b223-1","text":"魴魚赬尾、王室如燬 。"},{"id":"p1e5ff47294a6-1","text":"雖則如燬、父母孔邇 。"},{"id":"p4f698b404912-1","text":"11.  麟之趾"},{"id":"pcba0293ab0eb-1","text":"麟之趾、振振公子。"},{"id":"pe459ccd34d47-1","text":"于嗟麟兮。"},{"id":"p581024e8e68b-1","text":"麟之定、振振公姓。"},{"id":"pe459ccd34d47-2","text":"于嗟麟兮。"},{"id":"p1848360e59bd-1","text":"麟之角、振振公族。"},{"id":"pe459ccd34d47-3","text":"于嗟麟兮。"},{"id":"pea57887ab5c9-1","text":"召南"},{"id":"p0590b18d280a-1","text":"12.  鵲巢"},{"id":"p8611617f7339-1","text":"維鵲有巢、維鳩居之。"},{"id":"p7d4a90f34912-1","text":"之子于歸、百兩御之。"},{"id":"p2815a27bfead-1","text":"維鵲有巢、維鳩方之。"},{"id":"p488a6514db3e-1","text":"之子于歸、百兩將之。"},{"id":"p50bfef9778fe-1","text":"維鵲有巢、維鳩盈之。"},{"id":"p437e6a0c9525-1","text":"之子于歸、百兩成之。"},{"id":"p6a9c2af31733-1","text":"13.  采蘩"},{"id":"p711aa248f37b-1","text":"于以采蘩、于沼于沚。"},{"id":"p422264119ba9-1","text":"于以用之、公侯之事。"},{"id":"pd51dc13c0ba5-1","text":"于以采蘩、于澗之中。"},{"id":"pd2d72e785322-1","text":"于以用之、公侯之宮。"},{"id":"p63b0fd1cdb37-1","text":"被之僮僮、夙夜在公。"},{"id":"p555eea9eb170-1","text":"被之祁祁、薄言還歸。"},{"id":"pd5004a102478-1","text":"14.  草蟲"},{"id":"pf0ecd063d725-1","text":"喓喓草蟲、趯趯阜螽"},{"id":"pe24c9bb3cf9e-1","text":"未見君子、憂心忡忡。"},{"id":"pb69873c69d36-1","text":"亦既見止、亦既覯止、我心則降。"},{"id":"p9dc59d53e5d7-1","text":"陟彼南山、言采其蕨。"},{"id":"peb77aa6ba81f-1","text":"未見君子、憂心惙惙。"},{"id":"pf16c4a284a17-1","text":"亦既見止、亦既覯止、我心則說。"},{"id":"pbee99f8e4bfd-1","text":"陟彼南山、言采其薇。"},{"id":"p3b1e455217b4-1","text":"未見君子、我心傷悲。"},{"id":"p19bbcb12eba9-1","text":"亦既見止、亦既覯止、我心則夷。"},{"id":"pa452e542ca97-1","text":"15.  采蘋"},{"id":"p6d3be87c6929-1","text":"于以采蘋、南澗之濱。"},{"id":"p5a780061acbc-1","text":"于以采藻、于彼行潦。"},{"id":"p938f3e92a25d-1","text":"于以盛之、維筐及筥。"},{"id":"pf8aff3cfc21b-1","text":"于以湘之、維錡及釜。"},{"id":"pf532922e9cf9-1","text":"于以奠之、宗室牖下。"},{"id":"pea8c6d054580-1","text":"誰起尸之、有齊季女。"},{"id":"p60fa8db2ef91-1","text":"16.  甘棠"},{"id":"pdb0f19053442-1","text":"蔽芾甘棠、勿翦勿伐、召伯所茇。"},{"id":"pab4a14304c4e-1","text":"蔽芾甘棠、勿翦勿敗、召伯所憩。"},{"id":"p890e2c6b03c0-1","text":"蔽芾甘棠、勿翦勿拜、召伯所說。"},{"id":"p422ff794588e-1","text":"17.  行露"},{"id":"pde8588995ea3-1","text":"厭浥行露、豈不夙夜、謂行多露。"},{"id":"pfd6248729e06-1","text":"誰謂雀無角、何以穿我屋。"},{"id":"p5b30a99d7d91-1","text":"誰謂女無家、何以速我獄。"},{"id":"pa0457704dd76-1","text":"雖速我獄、室家不足。"},{"id":"pedd63d249688-1","text":"誰謂鼠無牙、何以穿我墉。"},{"id":"p6f6233ae7602-1","text":"誰謂女無家、何以速我訟。"},{"id":"p45721bb32bf2-1","text":"雖速我獄、亦不女從。"},{"id":"p06b5adc1ccce-1","text":"18.  羔羊"},{"id":"p55916e30b0a8-1","text":"羔羊之皮、素絲五紽。"},{"id":"p90d52d91e71f-1","text":"退食自公、委蛇委蛇。"},{"id":"pce3e498f0992-1","text":"羔羊之革、素絲五緎。"},{"id":"pc9d67dfaf022-1","text":"委蛇委蛇、自公退食。"},{"id":"pa4dc5ea2f513-1","text":"羔羊之縫、素絲五總。"},{"id":"p8aa327290e24-1","text":"委蛇委蛇、退食自公。"},{"id":"pac7c4dc3b590-1","text":"19.  殷其雷"},{"id":"p9bfb9fde5469-1","text":"殷其雷、在南山之陽。"},{"id":"p5d2cfc849b55-1","text":"何斯違斯、莫敢或遑。"},{"id":"p94027ab99ce8-1","text":"振振君子、歸哉歸哉。"},{"id":"pa4b51e321cd5-1","text":"殷其雷、在南山之側。"},{"id":"p66c284c3c436-1","text":"何斯違斯、莫敢遑息。"},{"id":"p94027ab99ce8-2","text":"振振君子、歸哉歸哉。"},{"id":"pa386159c786a-1","text":"殷其雷、在南山之下。"},{"id":"pa1648b89a7c6-1","text":"何斯違斯、莫敢遑處。"},{"id":"p94027ab99ce8-3","text":"振振君子、歸哉歸哉。"},{"id":"p9844ffa90bde-1","text":"20.   摽有梅"},{"id":"p5898a3b86e24-1","text":"摽有梅、其實七兮。"},{"id":"p3aeef49986db-1","text":"求我庶士、迨其吉兮。"},{"id":"p20e0b881ff43-1","text":"摽有梅、其實三兮。"},{"id":"p84672d2cb201-1","text":"求我庶士、迨其今兮。"},{"id":"p86634bd98699-1","text":"摽有梅、頃筐塈之。"},{"id":"pbbd352258f8c-1","text":"求我庶士、迨其謂之。"},{"id":"p887db0b8505c-1","text":"21.  小星"},{"id":"pd35e5d5dcd7f-1","text":"嘒彼小星、三五在東。"},{"id":"p72aa781f23c1-1","text":"肅肅宵征、夙夜在公、寔命不同。"},{"id":"p8069d1ec51ba-1","text":"嘒彼小星、 維參與昴。"},{"id":"pb79a11aac231-1","text":"肅肅宵征、抱衾與裯、寔命不猶。"},{"id":"p72818f9a04a7-1","text":"22.  江有汜"},{"id":"pc4543d3b885f-1","text":"江有汜、之子歸、不我以。"},{"id":"p5ee98e8216b2-1","text":"不我以、其後也悔。"},{"id":"p24e5ff8c1316-1","text":"江有渚、之子歸、不我與。"},{"id":"pa1d7a9454022-1","text":"不我與、其後也處。"},{"id":"pe20d81b364cd-1","text":"江有沱、之子歸、不我過。"},{"id":"p0c4e5711767d-1","text":"不我過、其嘯也歌。"},{"id":"pad9b3a760950-1","text":"23.  野有死麇"},{"id":"p1022a852d4e4-1","text":"野有死麇、白茅包之。"},{"id":"p2a57980e4087-1","text":"有女懷春、吉士誘之。"},{"id":"pcd5f01863a82-1","text":"林有樸樕、野有死鹿。"},{"id":"p61274f1583f4-1","text":"白茅純束、有女如玉。"},{"id":"pd85f4e67d18a-1","text":"舒而脫脫兮、無感我帨兮、無使尨也吠。"},{"id":"pe5838f0bb259-1","text":"24.  何彼襛矣"},{"id":"p186e8700fc93-1","text":"何彼襛矣、唐棣之華。"},{"id":"pb0b7bc7b5079-1","text":"曷不肅雝、王姬之車。"},{"id":"pbc56925750bc-1","text":"何彼襛矣、華如桃李。"},{"id":"p0ba1d16fc354-1","text":"平王之孫、齊侯之子。"},{"id":"p80923813b0b4-1","text":"其釣維何、維絲伊緡。"},{"id":"p0618e5801255-1","text":"齊侯之子、平王之孫。"},{"id":"p32193b445309-1","text":"25.  騶虞"},{"id":"p62261c01ad51-1","text":"彼茁者葭、壹發五豝。"},{"id":"p0114ff586cc5-1","text":"于嗟乎騶虞。"},{"id":"p6675c79ebc52-1","text":"彼茁者蓬、壹發五豵。"},{"id":"p0114ff586cc5-2","text":"于嗟乎騶虞。"},{"id":"pb89c806251db-1","text":"邶風"},{"id":"p2b41aaf042fe-1","text":"26.  柏舟"},{"id":"pedc15edce246-1","text":"汎彼柏舟、亦汎其流。"},{"id":"p9f682a2d541c-1","text":"耿耿不寐、如有隱憂。"},{"id":"p821f7011fb06-1","text":"微我無酒、以敖以遊。"},{"id":"p07633b0baa58-1","text":"我心匪鑒、不可以茹。"},{"id":"p37624c7964ee-1","text":"亦有兄弟、不可以據。"},{"id":"p7b4445065d20-1","text":"薄言往愬、逢彼之怒。"},{"id":"pf8048beea9b8-1","text":"我心匪石、不可轉也。"},{"id":"p6662475ab957-1","text":"我心匪席、不可卷也。"},{"id":"pb0ffcb2ac40a-1","text":"威儀棣棣、不可選也。"},{"id":"pfe01f405e272-1","text":"憂心悄悄、慍于群小。"},{"id":"p9b848e8762b1-1","text":"覯閔既多、受侮不少。"},{"id":"p25fd130c7924-1","text":"靜言思之、寤辟有摽。"},{"id":"p419e09f769cf-1","text":"日居月諸、胡迭而微。"},{"id":"p40cf7a4bccbe-1","text":"心之憂矣、如匪澣衣。"},{"id":"pb348415571a5-1","text":"靜言思之、不能奮飛。"},{"id":"p8a776f93d10e-1","text":"27.  綠衣"},{"id":"p25429ce310c6-1","text":"綠兮衣兮、綠兮黃裏。"},{"id":"p387bbb692d5d-1","text":"心之憂矣、曷維其已。"},{"id":"pe6d4ca632492-1","text":"綠兮衣兮、綠兮黃裳。"},{"id":"pf84f7c41a6c5-1","text":"心之憂矣、曷維其亡。"},{"id":"p66aa25c10262-1","text":"綠兮絲兮、女所治兮。"},{"id":"p61e458aaa925-1","text":"我思古人、俾無訧兮。"},{"id":"p7561c690557c-1","text":"稀兮綌兮、淒其以風。"},{"id":"pa5e347a1647a-1","text":"我思古人、實獲我心。"},{"id":"p30450f2d722b-1","text":"28.  燕燕"},{"id":"p69f006e95dc6-1","text":"燕燕于飛、差池其羽。"},{"id":"p385aa909c23f-1","text":"之子于歸、遠送于野。"},{"id":"pff3b7efd97f8-1","text":"瞻望弗及、泣涕如雨。"},{"id":"p660beb114386-1","text":"燕燕于飛、頡之頏之。"},{"id":"pe30f8e6b6ca6-1","text":"之子于歸、遠于將之。"},{"id":"p69ebf760eb40-1","text":"瞻望弗及、佇立以泣。"},{"id":"p0eea586b725a-1","text":"燕燕于飛、下上其音。"},{"id":"pf31e6f455e95-1","text":"之子于歸、遠送于南。"},{"id":"p3f121ca9eebf-1","text":"瞻望弗及、實勞我心。"},{"id":"p4f4edff92dfd-1","text":"仲氏任只、其心塞淵。"},{"id":"pb446c489d5b1-1","text":"終溫且惠、淑慎其身。"},{"id":"p91498c5d5504-1","text":"先君之思、以勗寡人。"},{"id":"p56a421fff2e8-1","text":"29.  日月"},{"id":"p9f1719cfe151-1","text":"日居月諸、照臨下土。"},{"id":"p647deb0b8c14-1","text":"乃如之人兮、逝不古處。"},{"id":"p17f3fb5a4913-1","text":"胡能有定、寧不我顧。"},{"id":"p89cd5ca203b1-1","text":"日居月諸、下土是冒。"},{"id":"pfca88bae4964-1","text":"乃如之人兮、逝不相好。"},{"id":"p20cfb930ee87-1","text":"胡能有定、寧不我報。"},{"id":"p56c69bcdb4cf-1","text":"日居月諸、出自東方。"},{"id":"pae15d08c2359-1","text":"乃如之人兮、德音無良。"},{"id":"p25eff85e8417-1","text":"胡能有定、俾也可忘。"},{"id":"ped516840faa4-1","text":"日居月諸、東方自出。"},{"id":"pea4fb9a22773-1","text":"父兮母兮、畜我不卒。"},{"id":"p540937c1e7f0-1","text":"胡能有定、報我不述。"},{"id":"pf0be4cf5575b-1","text":"30.  終風"},{"id":"p5fd94adea747-1","text":"終風且暴、顧我則笑。"},{"id":"p8989e7774b3c-1","text":"謔浪笑敖、中心是悼。"},{"id":"p534d0ec016fc-1","text":"終風且霾、惠然肯來。"},{"id":"pb50b310ea969-1","text":"莫往莫來、悠悠我思。"},{"id":"pc7498fdbafff-1","text":"終風且曀、不日有曀。"},{"id":"p70eb142b4116-1","text":"寤言不寐、願言則嚏。"},{"id":"pc8f2612b57d5-1","text":"曀曀其陰、虺虺其雷。"},{"id":"p467cbf09ed6b-1","text":"寤言不寐、願言則懷。"},{"id":"pb77d57962ab3-1","text":"31.  擊鼓"},{"id":"p1c8f590316c5-1","text":"擊鼓其鏜、踊躍用兵。"},{"id":"p69ca3d483e12-1","text":"土國城漕、我獨南行。"},{"id":"p6f22cb3f282a-1","text":"從孫子仲、平陳與宋。"},{"id":"p0960a1d76f06-1","text":"不我以歸、憂心有忡。"},{"id":"p0763a057986b-1","text":"爰居爰處、爰喪其馬。"},{"id":"pfa5231149885-1","text":"于以求之、于林之下。"},{"id":"p8528ca5b29ab-1","text":"死生契闊、與子成說。"},{"id":"pe2f8377c5b59-1","text":"執子之手、與子偕老。"},{"id":"pb98bac300f71-1","text":"于嗟闊兮、不我活兮。"},{"id":"pb645401eb828-1","text":"于嗟洵兮、不我信兮。"},{"id":"p3273ec8c36f8-1","text":"32.  凱風"},{"id":"p53f458eab20a-1","text":"凱風自南、吹彼棘心。"},{"id":"p7385ba468e55-1","text":"棘心夭夭、母氏劬勞。"},{"id":"p7e448c92c32d-1","text":"凱風自南、吹彼棘薪。"},{"id":"p5c651df11c64-1","text":"母氏聖善、我無令人。"},{"id":"p2f1461cefa48-1","text":"爰有寒泉、在浚之下。"},{"id":"pf742e344515d-1","text":"有子七人、母氏勞苦。"},{"id":"p9f535820344b-1","text":"睍睆黃鳥、載好其音。"},{"id":"p94d7e162c5c7-1","text":"有子其人、莫慰母心。"},{"id":"p99d644ac7ae6-1","text":"33.  雄雉"},{"id":"pccc35c82ce19-1","text":"雄雉于飛、泄泄其羽。"},{"id":"pee9e5abe9cc7-1","text":"我之懷矣、自詒伊阻。"},{"id":"p43bbfd65a1bc-1","text":"雄雉于飛、下上其音。"},{"id":"p12c864eb558c-1","text":"展矣君子、實勞我心。"},{"id":"pbf7391769e3e-1","text":"瞻彼日月、悠悠我思。"},{"id":"p7089ebdc28a1-1","text":"道之云遠、曷云能來。"},{"id":"p09c746e0f190-1","text":"百爾君子、不知德行。"},{"id":"p7c751ddb08fe-1","text":"不忮不求、何用不臧。"},{"id":"p9662813dcae3-1","text":"34.  匏有苦葉"},{"id":"p5b63350b6c9b-1","text":"匏有苦葉、濟有深涉。"},{"id":"pde262a376518-1","text":"深則厲、淺則揭。"},{"id":"p95048f3a62cc-1","text":"有瀰濟盈、有鷕雉鳴。"},{"id":"p9cdb548b76ee-1","text":"濟盈不濡軌、雉鳴求起牡。"},{"id":"pb3282ba62bc5-1","text":"雝雝鳴鴈、旭日始旦。"},{"id":"p07665fa89e21-1","text":"士如歸妻、迨冰未泮。"},{"id":"p4be11e1b2ec8-1","text":"招招舟子、人涉卬否。"},{"id":"p0830ee40b716-1","text":"人涉卬否、卬須我友。"},{"id":"p78b4d0e1eda8-1","text":"35.  谷風"},{"id":"p7ed30c320296-1","text":"習習谷風、以陰以雨。"},{"id":"p79ed13dfdfe0-1","text":"黽勉同心、不宜有怒。"},{"id":"pedeba168d92c-1","text":"采封采菲、無以下體。"},{"id":"pf830d866d00d-1","text":"德音莫違、及爾同死。"},{"id":"pae6bea1bdc22-1","text":"行道遲遲、中心有違。"},{"id":"p977663a74b39-1","text":"不遠伊邇、薄送我畿。"},{"id":"p1e1b6e2778db-1","text":"誰謂荼苦、其甘如薺。"},{"id":"p1225b2f7bdc6-1","text":"宴爾新昏、如兄如弟。"},{"id":"p61c92e278261-1","text":"涇以渭濁、湜湜其沚。"},{"id":"pa48516f5ae43-1","text":"宴爾新昏、不我屑以。"},{"id":"pf1c7d3ea51d3-1","text":"毋逝我梁、毋發我笱。"},{"id":"p3be754a94013-1","text":"我躬不閱、遑恤我後。"},{"id":"pbc9e5bbecd6b-1","text":"就其深矣、方之舟之。"},{"id":"pd815011fa6a6-1","text":"就其淺矣、泳之游之。"},{"id":"p06172b1e0375-1","text":"何有何亡、黽勉求之。"},{"id":"p3bfa6bb6fc7c-1","text":"凡民有喪、匍匐救之。"},{"id":"p27b7fd37c2e7-1","text":"不我能慉、反以我為讎。"},{"id":"pd8241b396f47-1","text":"既阻我德、賈用不售。"},{"id":"pdf4ef3a769ec-1","text":"昔育恐育鞫、及爾顛覆。"},{"id":"p02ffca0ee1d2-1","text":"既生既育、比予于毒。"},{"id":"p5ba6e1090c8e-1","text":"我有旨蓄、亦以御冬。"},{"id":"p4b14be68a12d-1","text":"宴爾新昏、以我御窮。"},{"id":"p1f0f79a72787-1","text":"有洸有潰、既詒我肄。"},{"id":"p7c54449dab31-1","text":"不念昔者、伊余來塈。"},{"id":"p906c41c44420-1","text":"36.  式微"},{"id":"p70f69b3ae0ae-1","text":"式微式微、胡不歸。"},{"id":"p683392d95c01-1","text":"微君之故、胡為乎中露。"},{"id":"p70f69b3ae0ae-2","text":"式微式微、胡不歸。"},{"id":"pa3cf35178424-1","text":"微君之躬、胡為乎泥中。"},{"id":"p18a5f181374d-1","text":"37.  旄丘"},{"id":"p28413e641b68-1","text":"旄丘之葛兮、何誕之節兮。"},{"id":"pb5cadded6816-1","text":"叔兮伯兮、何多日也。"},{"id":"p6e1375316b49-1","text":"何其處也、必有與也。"},{"id":"p2b49afac6df7-1","text":"何其久也、必有以也。"},{"id":"p9c31ce56451b-1","text":"狐裘蒙戎、匪車不東。"},{"id":"pe2fc738f3a84-1","text":"叔兮伯兮、靡所與同。"},{"id":"pd608944862e0-1","text":"瑣兮尾兮、流離之子。"},{"id":"pd786b7623a24-1","text":"叔兮伯兮、褎如充耳。"},{"id":"p4b43689270e5-1","text":"38.  簡兮"},{"id":"p7080a209930b-1","text":"簡兮簡兮、方將萬舞。"},{"id":"p7f0f0e3bceeb-1","text":"日之方中、在前上處。"},{"id":"pb502def01d0f-1","text":"碩人俁俁、公庭萬舞。"},{"id":"p85575ab42444-1","text":"有力如虎、執轡如組。"},{"id":"p14fc58cd5397-1","text":"左手執籥、右手秉翟。"},{"id":"p155662b82fa0-1","text":"赫如渥赭、公言錫爵。"},{"id":"pe3cbc0b4bd1c-1","text":"山有榛、隰有苓。"},{"id":"pecbecad08443-1","text":"云誰之思、西方美人。"},{"id":"p18d34a46b895-1","text":"彼美人兮、西方之人兮。"},{"id":"p8d78c2b6ce1c-1","text":"39.  泉水"},{"id":"p5c2a1f82f8c0-1","text":"毖彼泉水、亦流于淇。"},{"id":"p65ed08c54e3c-1","text":"有懷于衛、靡日不思。"},{"id":"pe0e97e3482c9-1","text":"孌彼諸姬、聊與之謀。"},{"id":"pf66522eab4b1-1","text":"出宿于泲、飲餞于禰。"},{"id":"p0627d2f69bdb-1","text":"女子有行、遠父母兄弟。"},{"id":"p53eebe6ef4b2-1","text":"問我諸姑、遂及伯姊。"},{"id":"p61d9a366533e-1","text":"出宿于干、飲餞于言。"},{"id":"p172d266d2353-1","text":"載脂載牽、還車言邁。"},{"id":"pf0b86730b0fe-1","text":"遄臻于衛、不瑕有害。"},{"id":"pb5f0f1d4bcc5-1","text":"我思肥泉、茲之永歎。"},{"id":"pa1a3546a9663-1","text":"思須與漕、我心悠悠。"},{"id":"pf9985b815f92-1","text":"駕言出游、以寫我憂。"},{"id":"p36b357cceadb-1","text":"40.  北門"},{"id":"p41bd4756d4c5-1","text":"出自北門、憂心殷殷。"},{"id":"pca308b177b68-1","text":"終窶且貧、莫知我艱。"},{"id":"p703309f4085d-1","text":"已焉哉、天實為之、謂之何哉。"},{"id":"p5c0f9c372549-1","text":"王事適我、政事一埤益我。"},{"id":"p2428b0a6ddb8-1","text":"我入自外、室人交遍謫我。"},{"id":"p703309f4085d-2","text":"已焉哉、天實為之、謂之何哉。"},{"id":"pb061ada2d9d1-1","text":"王事敦我、政事一埤遺我。"},{"id":"p087cf501a102-1","text":"我入自外、室人交遍摧我。"},{"id":"p703309f4085d-3","text":"已焉哉、天實為之、謂之何哉。"},{"id":"p6f0969bb8816-1","text":"41.  北風"},{"id":"pc073fc5a6f47-1","text":"北風其涼、雨雪其雱。"},{"id":"pf12fdf868ecf-1","text":"惠而好我、攜手同行。"},{"id":"p95175ebd29dc-1","text":"其虛其邪、既亟只且。"},{"id":"pbf3517946242-1","text":"北風其喈、雨雪其霏。"},{"id":"p72702eb98644-1","text":"惠而好我、攜手同歸。"},{"id":"p95175ebd29dc-2","text":"其虛其邪、既亟只且。"},{"id":"p2ee346584b71-1","text":"莫赤匪狐、莫黑匪烏。"},{"id":"p6cdb8d02ab8d-1","text":"惠而好我、攜手同車。"},{"id":"p95175ebd29dc-3","text":"其虛其邪、既亟只且。"},{"id":"pd14283e6c527-1","text":"42.  靜女"},{"id":"p396ad43d4c29-1","text":"靜女其姝、俟我於城隅。"},{"id":"p3cdfee60a8de-1","text":"愛而不見、搔首踟躕。"},{"id":"pa9aa19f936b3-1","text":"靜女其孌、貽我彤管。"},{"id":"p67615eadef0a-1","text":"彤管有煒、說懌女美。"},{"id":"p49ef2a6c2924-1","text":"自牧歸荑、洵美且異。"},{"id":"pc8a731213ed3-1","text":"匪女以為美、美人之貽。"},{"id":"p8c2f8c3af55d-1","text":"43.  新臺"},{"id":"pc0d87b6fd9d8-1","text":"新臺有沘、河水彌彌。"},{"id":"p8f54bc1bc45d-1","text":"燕婉之求、籧篨不鮮。"},{"id":"p999dab0301da-1","text":"新臺有洒、河水浼浼。"},{"id":"pe5a4e9ddb5db-1","text":"燕婉之求、籧篨不殄。"},{"id":"p748f6d00fbee-1","text":"魚網之設、鴻則離之。"},{"id":"pd39890ae47cd-1","text":"燕婉之求、得此戚施。"},{"id":"pb43879533503-1","text":"44.  二子乘舟"},{"id":"pf9f3e5679f5f-1","text":"二子乘舟、汎汎其景。"},{"id":"pf89ec1015a6c-1","text":"願言思子、中心養養。"},{"id":"pf03f51b114d1-1","text":"二子乘舟、汎汎其逝。"},{"id":"p151382532e20-1","text":"願言思子、不瑕有害。"},{"id":"pca3d39655301-1","text":"鄘風"},{"id":"pdbd162c4921f-1","text":"45.  柏舟"},{"id":"pd4badb3f05fe-1","text":"汎彼柏舟、在彼中河。"},{"id":"p9b1b1c51dbef-1","text":"髧彼兩髦、實維我儀。"},{"id":"p457606babfee-1","text":"之死矢靡它。"},{"id":"pa8ae20c752f6-1","text":"母也天只、不諒人只。"},{"id":"p911cb3876528-1","text":"汎彼柏舟、在彼河側。"},{"id":"pba1567645229-1","text":"髧彼兩髦、實維我特。"},{"id":"pdfefe124a8f7-1","text":"之死矢靡慝。"},{"id":"pa8ae20c752f6-2","text":"母也天只、不諒人只。"},{"id":"pf3f02b18bb69-1","text":"46.  牆有茨"},{"id":"paef60cd7813c-1","text":"牆有茨、不可埽也。"},{"id":"p43dad9e2b6b7-1","text":"中冓之言、不可道也。"},{"id":"p64e1ef336055-1","text":"所可道也、言之醜也。"},{"id":"pdb4180fc06bc-1","text":"牆有茨、不可襄也。"},{"id":"p04e5d3da9621-1","text":"中冓之言、不可詳也。"},{"id":"p9dbbc4e40659-1","text":"所可詳也、言之長也。"},{"id":"p9681f4dac84a-1","text":"牆有茨、不可束也。"},{"id":"p06519d5804b0-1","text":"中冓之言、不可讀也。"},{"id":"p9c6dd48878e0-1","text":"所可讀也、言之辱也。"},{"id":"p75c4a3a9951c-1","text":"47.  君子偕老"},{"id":"p7fd63f5ef661-1","text":"君子偕老、副笄六珈。"},{"id":"p9e3c6c56f376-1","text":"委委佗佗、如山如河、象服是宜。"},{"id":"p17ce9907d331-1","text":"子之不淑、云如之何。"},{"id":"p7b1198c2631c-1","text":"玼兮玼兮、其之翟也。"},{"id":"p1dd242a445d1-1","text":"鬒髮如云、不屑也。"},{"id":"p1c5e52e019a0-1","text":"玉之瑱也、象之揥也、揚且之皙也。"},{"id":"pe41d6abfe29a-1","text":"胡然而天也、胡然而帝也。"},{"id":"p56160b386cc3-1","text":"瑳兮瑳兮、其之展也。"},{"id":"pb03f530dc417-1","text":"蒙彼縐絺、是紲袢也。"},{"id":"p2ed55e88fa91-1","text":"子之清揚、揚且之顏也。"},{"id":"p3d544cfb3f50-1","text":"展如之人兮、邦之媛也。"},{"id":"p76f2e445b910-1","text":"48.  桑中"},{"id":"pfd5b96296eaf-1","text":"爰采唐矣、沬之鄉矣。"},{"id":"p206c79ba6cd8-1","text":"云誰之思、美孟姜矣。"},{"id":"p0f785b74acc4-1","text":"期我乎桑中、要我乎上宮、送我乎淇之上矣。"},{"id":"pb006713298f0-1","text":"爰采麥矣、沬之北矣。"},{"id":"p46f9e7c2454b-1","text":"云誰之思、美孟弋矣。"},{"id":"p97f84f114ab8-1","text":"期我乎桑中、要我乎上宮、送我乎淇之上矣 。"},{"id":"pfea9ef41728f-1","text":"爰采葑矣、沬之東矣。"},{"id":"p9107ae5a0d8f-1","text":"云誰之思、美孟庸矣。"},{"id":"p0f785b74acc4-2","text":"期我乎桑中、要我乎上宮、送我乎淇之上矣。"},{"id":"p818c76cc9a86-1","text":"49.  鶉之奔奔"},{"id":"p4c42ca2d2219-1","text":"鶉之奔奔、鵲之彊彊。"},{"id":"p9a4c343f06de-1","text":"人之無良、我以為兄。"},{"id":"pe3dc631c1c47-1","text":"鵲之彊彊、鶉之奔奔。"},{"id":"pf3408d0cfe9c-1","text":"人之無良、我以為君。"},{"id":"p8fe7eaff1c1c-1","text":"50.  定之方中"},{"id":"pefd76869c01a-1","text":"定之方中、作于楚宮。"},{"id":"p23fcd553cb87-1","text":"揆之以日、作于楚室。"},{"id":"pcff0d5ef33dd-1","text":"樹之榛栗、椅桐梓漆、爰伐琴瑟。"},{"id":"p0a27544b29c6-1","text":"升彼虛矣、以望楚矣。"},{"id":"p4dfb9b19b232-1","text":"望楚與堂、景山與京。"},{"id":"p15ddd8fbdd32-1","text":"降觀于桑、卜云其吉、終然允臧。"},{"id":"p2ae6cb083ff1-1","text":"靈雨既零、命彼倌人。"},{"id":"p963d5543e23b-1","text":"星言夙駕、說于桑田。"},{"id":"pc930585a743d-1","text":"匪直也人、秉心塞淵、騋牝三千。"},{"id":"p998c3e4827f2-1","text":"51.  蝃蝀"},{"id":"p58c9c9e0d8a4-1","text":"蝃蝀在東、莫之敢指。"},{"id":"pd08f4c2a25bc-1","text":"女子有行、遠兄弟父母。"},{"id":"pdc2d70dd837a-1","text":"朝隮于西、崇朝其雨。"},{"id":"pd08f4c2a25bc-2","text":"女子有行、遠兄弟父母。"},{"id":"paf868a249ce1-1","text":"乃如之人也、懷昏姻也。"},{"id":"p78899a0f298d-1","text":"大無信也、不知命也。"},{"id":"p3f0f35b3fee9-1","text":"52.  相鼠"},{"id":"pf2a649d12168-1","text":"相鼠有皮、人而無儀。"},{"id":"p8a50ba5b7c25-1","text":"人而無儀、不死何為。"},{"id":"pfc1cca4b1c20-1","text":"相鼠有齒、人而無止。"},{"id":"pb3f4814cf165-1","text":"人而無止、不死何俟。"},{"id":"pf4a29e7b402d-1","text":"相鼠有體、人而無禮。"},{"id":"p89f23ad40c09-1","text":"人而無禮、胡不遄死。"},{"id":"pc4323b1f9941-1","text":"53.  干旄"},{"id":"p6859bc49049b-1","text":"孑孑干旄、在浚之郊。"},{"id":"pfa93ae52531c-1","text":"素絲紕之、良馬四之。"},{"id":"pebe453cd3902-1","text":"彼姝者之、何以畀之。"},{"id":"p932d99999eaf-1","text":"孑孑干旟、在浚之都。"},{"id":"p12c0495702ae-1","text":"素絲組之、良馬五之。"},{"id":"pf56f87015369-1","text":"彼姝者之、何以予之。"},{"id":"p91055de5322a-1","text":"孑孑干旌、在浚之城。"},{"id":"p337e64532af6-1","text":"素絲祝之、良馬六之。"},{"id":"pd7e9185f1585-1","text":"彼姝者之、何以告之。"},{"id":"pe2d0b246edb4-1","text":"54.  載馳"},{"id":"pe59767562403-1","text":"載馳載驅、歸唁衛侯。"},{"id":"p6f60df9b97e4-1","text":"驅馬悠悠、言至于漕。"},{"id":"p1995116c4e62-1","text":"大夫跋涉、我心則憂。"},{"id":"pe01f04226891-1","text":"既不我嘉、不能旋反。"},{"id":"pc0c0531f37ac-1","text":"視而不臧、我思不遠。"},{"id":"pea528ebfa3ad-1","text":"既不我嘉、不能旋濟。"},{"id":"pda7c9ff59eeb-1","text":"視而不臧、我思不閟。"},{"id":"pd81c10a2e88e-1","text":"陟彼阿丘、言采其虻。"},{"id":"p1666b5afe427-1","text":"女子善懷、亦各有行。"},{"id":"p104e1fb04ba7-1","text":"許人尤之、眾樨且狂。"},{"id":"p15b0a0e3dbcf-1","text":"我行其野、芃芃其麥。"},{"id":"p759c0a09da96-1","text":"控于大邦、誰因誰極。"},{"id":"p7cd35565469c-1","text":"大夫君子、無我有尤。"},{"id":"p7a64775933dc-1","text":"百爾所思、不如我所之。"},{"id":"pae80ed57251c-1","text":"衛風"},{"id":"p9b6d290fe69b-1","text":"55.  淇奧"},{"id":"p1b8a227304a4-1","text":"瞻彼淇奧、綠竹猗猗。"},{"id":"pc1ded02d46f3-1","text":"有匪君子、如切如磋、如琢如磨。"},{"id":"pf7cd7d99e0fb-1","text":"瑟兮僩兮、赫兮咺兮。"},{"id":"p2f19dbff4973-1","text":"有匪君子、終不可諼兮。"},{"id":"pa3b1de2870e1-1","text":"瞻彼淇奧、綠竹青青。"},{"id":"p44a059e20c71-1","text":"有匪君子、充耳琇瑩、會弁如星。"},{"id":"pf7cd7d99e0fb-2","text":"瑟兮僩兮、赫兮咺兮。"},{"id":"p2f19dbff4973-2","text":"有匪君子、終不可諼兮。"},{"id":"pc54142298701-1","text":"瞻彼淇奧、綠竹如簀。"},{"id":"pef11901eaf65-1","text":"有匪君子、如切如錫、如圭如璧。"},{"id":"pa3aea4976ada-1","text":"寬兮綽兮、猗重較兮。"},{"id":"p0b0612665c6b-1","text":"善戲謔兮、不為虐兮。"},{"id":"pb8047d6642ec-1","text":"56.  考槃"},{"id":"p5516867df589-1","text":"考槃在澗、碩人之寬。"},{"id":"p2ed15697395d-1","text":"獨寐寤言、永矢弗諼。"},{"id":"pd75544d9a2f8-1","text":"考槃在阿、碩人之薖。"},{"id":"p230eb1ee0989-1","text":"獨寐寤歌、永矢弗過。"},{"id":"p39ca806764b7-1","text":"考槃在陸、碩人之軸。"},{"id":"pbaab1e26ef8a-1","text":"獨寐寤宿、永矢弗告。"},{"id":"p0967ad2764db-1","text":"57.  碩人"},{"id":"p87013e3174ca-1","text":"碩人其頎、衣錦褧衣。"},{"id":"p4d8546bc4335-1","text":"齊侯之子、衛侯之妻、東宮之妹、邢侯之姨、譚公維私。"},{"id":"p338c27deff81-1","text":"手如柔荑。"},{"id":"peabc0cc3ec19-1","text":"膚如凝脂。"},{"id":"p8298f68605f0-1","text":"領如蝤蠐。"},{"id":"p8298f68605f0-2","text":"領如蝤蠐。"},{"id":"pa0d6655e1bbe-1","text":"齒如瓠犀。"},{"id":"pfc96789762be-1","text":"螓首蛾眉。"},{"id":"p1e66f7ed330d-1","text":"巧笑倩兮。"},{"id":"pfb437a24bd53-1","text":"美目盼兮。"},{"id":"pdfe9ebc45699-1","text":"碩人敖敖、說于農郊。"},{"id":"pa4b1495cef70-1","text":"四牡有驕、朱幩鑣鑣、翟茀以朝。"},{"id":"pf7e353486d13-1","text":"大夫夙退、無使君勞。"},{"id":"p201134301c29-1","text":"河水洋洋、北流活活。"},{"id":"pb5e38f0090e6-1","text":"施罛瀖瀖、鱣鮪發發、葭菼揭揭。"},{"id":"pd9f72d73a2c1-1","text":"庶姜孽孽、庶士有朅。"},{"id":"p4a43277cd0ca-1","text":"58.  氓"},{"id":"p55c1e26900ad-1","text":"氓之蚩蚩、抱布貿絲。"},{"id":"p7984817359b9-1","text":"匪來貿絲、來即我謀。"},{"id":"p3b333c41b322-1","text":"送子涉淇、至于頓丘。"},{"id":"p775c2e6ac3b9-1","text":"匪來愆期、子無良媒。"},{"id":"p586cca6dd3df-1","text":"將子無怒、秋以為期。"},{"id":"p42b1a2a33af7-1","text":"乘彼垝垣、以望復關。"},{"id":"p1ed5bf200706-1","text":"不見復關、泣涕漣漣。"},{"id":"p869cfda4b08e-1","text":"既見復關、載笑載言。"},{"id":"p0d496c9bc013-1","text":"爾卜爾筮、體無咎言。"},{"id":"pf890b6c9669f-1","text":"以爾車來、以我賄遷。"},{"id":"p68360d4f752f-1","text":"桑之未落、其葉沃若。"},{"id":"p29d5d7f94bf3-1","text":"于嗟鳩兮、無食桑葚。"},{"id":"p3361d6133725-1","text":"于嗟女兮、無與士耽。"},{"id":"p419c7f809930-1","text":"士之耽兮、猶可說也、"},{"id":"p01d6af1a2a09-1","text":"女之耽兮、 不可說也。"},{"id":"p52266361c063-1","text":"桑之落矣、其黃而隕。"},{"id":"pdffb3471ec8b-1","text":"自我徂爾、三歲食貧。"},{"id":"p34b5f025fde7-1","text":"淇水湯湯、漸車帷裳。"},{"id":"pac7e981f0f0c-1","text":"女也不爽、士貳其行。"},{"id":"p5e07144c4a97-1","text":"士也罔極、二三其德。"},{"id":"p9a8efb0b5d59-1","text":"三歲為婦、靡室勞矣。"},{"id":"pc13fa82158fb-1","text":"夙興夜寐、靡有朝矣。"},{"id":"p8e25e6b89bcb-1","text":"言既遂矣、至于暴矣。"},{"id":"pcc215a09d62c-1","text":"兄弟不知、咥其笑矣。"},{"id":"p3107c776942b-1","text":"靜言思之、躬自悼矣。"},{"id":"p190f39fb8b78-1","text":"及爾偕老、老使我怨。"},{"id":"p0b047e92ba63-1","text":"淇則有岸、隰則有泮。"},{"id":"p4d3e4c284ff5-1","text":"總角之宴、言笑晏晏。"},{"id":"p82d94a48e44a-1","text":"信膂旦旦、不思其反。"},{"id":"p7fffdbdc8ced-1","text":"反是不思、亦已焉哉。"},{"id":"p7ecb3b4ecb75-1","text":"59.  竹竿"},{"id":"pae68bf91d921-1","text":"藋藋竹竿、以釣于淇。"},{"id":"pef219fbce23e-1","text":"豈不爾思、遠莫致之。"},{"id":"p546b0c99991c-1","text":"泉源在左、淇水在右。"},{"id":"pd08f4c2a25bc-3","text":"女子有行、遠兄弟父母。"},{"id":"p3c5d6a53d9ca-1","text":"淇水在右、泉源在左。"},{"id":"p9a96a613e0cb-1","text":"巧笑之瑎、佩玉之儺。"},{"id":"p4d6c9f0dea22-1","text":"淇水浟浟、檜楫松舟。"},{"id":"p0c1be961ea03-1","text":"駕言出遊、以寫我憂。"},{"id":"p7b7ce4d5a84a-1","text":"60.  芄蘭"},{"id":"pd390eedaa8c5-1","text":"芄蘭之支、童子佩觿。"},{"id":"p696ee580b4bc-1","text":"雖則佩觿、能不我知。"},{"id":"p9479d0498369-1","text":"容兮遂兮、垂帶悸兮。"},{"id":"pf93d395d9a02-1","text":"芄蘭之葉、童子佩韘。"},{"id":"pa75fa9c63b11-1","text":"雖則佩韘、能不我甲。"},{"id":"p9479d0498369-2","text":"容兮遂兮、垂帶悸兮。"},{"id":"pad010b86bb71-1","text":"61.  河廣"},{"id":"p8b9500489c72-1","text":"誰謂河廣、一葦杭之。"},{"id":"p08e943ba65e2-1","text":"誰謂宋遠、跂予望之。"},{"id":"p20bacbdf04d0-1","text":"誰謂河廣、曾不容刀。"},{"id":"p8c3f46cae30b-1","text":"誰謂宋遠、曾不崇朝。"},{"id":"p93faa67660f1-1","text":"62.  伯兮"},{"id":"pb5db6a675af7-1","text":"伯兮朅兮、邦之桀兮。"},{"id":"p25d8500455c2-1","text":"伯也執殳、為王前驅。"},{"id":"pda00388baeaa-1","text":"自伯之東、首如飛蓬。"},{"id":"pc0743ff174cc-1","text":"豈無膏沐、誰適為容。"},{"id":"pe00c46345aad-1","text":"其雨其雨、杲杲出日。"},{"id":"pab4fcbea263e-1","text":"願言思伯、甘心首疾。"},{"id":"p7b7379b6b180-1","text":"焉得諼草、言樹之背。"},{"id":"p55e5ee2b601c-1","text":"願言思伯、使我心痗。"},{"id":"p7683b24eab45-1","text":"63.  有狐"},{"id":"p2411831a176f-1","text":"有狐綏綏、在彼淇梁。"},{"id":"pcadc81c7aab7-1","text":"心之憂矣、之子無裳。"},{"id":"p453cc2dc300f-1","text":"有狐綏綏、在彼淇厲。"},{"id":"pe6614cbc0e13-1","text":"心之憂矣、之子無帶。"},{"id":"pd68801d54a3f-1","text":"有狐綏綏、在彼淇側。"},{"id":"pdda3e9f83e07-1","text":"心之憂矣、之子無服。"},{"id":"pb62fe49968ab-1","text":"64.  木瓜"},{"id":"p2a075aae09f0-1","text":"投我以木瓜、報之以瓊琚。"},{"id":"p8c2eced16c80-1","text":"匪報也、永以為好也。"},{"id":"p276d37828f4f-1","text":"投我以木桃、報之以瓊瑤。"},{"id":"p8c2eced16c80-2","text":"匪報也、永以為好也。"},{"id":"p729910dd0bb3-1","text":"投我以木李、報之以瓊玖。"},{"id":"p8c2eced16c80-3","text":"匪報也、永以為好也。"},{"id":"p54e839ca32f7-1","text":"王風"},{"id":"p1b8e97efe747-1","text":"65.  黍離"},{"id":"p64a9f7adfc3e-1","text":"彼黍離離、彼稷之苗。"},{"id":"p06e473139bf9-1","text":"行邁靡靡、中心搖搖。"},{"id":"pcd38bc83883a-1","text":"知我者、謂我心憂、不知我者、謂我何求。"},{"id":"p37ea878203e0-1","text":"悠悠蒼天、此何人哉。"},{"id":"pe04db9b9437c-1","text":"彼黍離離、彼稷之穗。"},{"id":"pd5d0fa0e76e8-1","text":"行邁靡靡、中心如醉。"},{"id":"pcd38bc83883a-2","text":"知我者、謂我心憂、不知我者、謂我何求。"},{"id":"p37ea878203e0-2","text":"悠悠蒼天、此何人哉。"},{"id":"pb749786dd6f9-1","text":"彼黍離離、彼稷之實。"},{"id":"p191d23004fa5-1","text":"行邁靡靡、中心如噎。"},{"id":"pcd38bc83883a-3","text":"知我者、謂我心憂、不知我者、謂我何求。"},{"id":"p37ea878203e0-3","text":"悠悠蒼天、此何人哉。"},{"id":"peea8cd8dec05-1","text":"66.  君子于役"},{"id":"pb656277ba4b4-1","text":"君子于役、不知其期、曷至哉。"},{"id":"p4c719c743e47-1","text":"雞棲于塒、日之夕矣、羊牛下來。"},{"id":"p9ea749c95681-1","text":"君子于役、如之何勿思。"},{"id":"p27d87e3535c8-1","text":"君子于役、不日不月、曷其有佸。"},{"id":"p0edc32dad9f7-1","text":"雞棲于桀、日之夕矣、羊牛下括。"},{"id":"pa45ced6d476a-1","text":"君子于役、茍無飢渴。"},{"id":"pcf3f558f8c49-1","text":"67.  君子陽陽"},{"id":"pd55c25f6afbd-1","text":"君子陽陽、左執簧、右招我由房。"},{"id":"p0807ed0288a8-1","text":"其樂只且。"},{"id":"pc9c15a11c6ad-1","text":"君子陶陶、左執翿、右招我由敖。"},{"id":"p0807ed0288a8-2","text":"其樂只且。"},{"id":"p094d6807dea9-1","text":"68.  揚之水"},{"id":"pe70a6d7b6f65-1","text":"揚之水、不流束薪。"},{"id":"p59fb00c50445-1","text":"彼其之子、不與我戍申。"},{"id":"pc43f1fc63414-1","text":"懷哉懷哉、曷月予還歸哉。"},{"id":"p23722ecf29aa-1","text":"揚之水、不流束楚。"},{"id":"pd42d6eb19590-1","text":"彼其之子、不與我戍甫。"},{"id":"pc43f1fc63414-2","text":"懷哉懷哉、曷月予還歸哉。"},{"id":"pb03f5a337ead-1","text":"揚之水、不流束蒲。"},{"id":"p9a9cf1d3b978-1","text":"彼其之子、不與我戍許。"},{"id":"pc43f1fc63414-3","text":"懷哉懷哉、曷月予還歸哉。"},{"id":"p314df3a1f7e1-1","text":"69.  中谷有蓷"},{"id":"pfcbe693a2c72-1","text":"中谷有蓷、暵其乾矣。"},{"id":"p47404f3a2702-1","text":"有女仳離、慨其歎矣。"},{"id":"p112864d53cdd-1","text":"慨其歎矣、遇人之艱難矣。"},{"id":"pa91f0b2139a1-1","text":"中谷有蓷、暵其修矣。"},{"id":"p531f36ca41b1-1","text":"有女仳離、條其嘯矣。"},{"id":"pbb9a477131ff-1","text":"慨其嘯矣、遇人之不淑矣。"},{"id":"pb6da2f0d4a55-1","text":"中谷有蓷、暵其濕矣。"},{"id":"p36054dbfd5c0-1","text":"有女仳離、啜其泣矣。"},{"id":"p9a269d05652c-1","text":"啜其泣矣、嗟何及矣。"},{"id":"p2bd92386c673-1","text":"70.  兔爰"},{"id":"pa89bb82d825c-1","text":"有兔爰爰、雉離于羅。"},{"id":"pe54e5648059d-1","text":"我生之初、尚無為。"},{"id":"p7bc004723d23-1","text":"我生之後、逢此百罹。"},{"id":"pbe23e5020805-1","text":"尚寐無吪。"},{"id":"pfeadc7773e2c-1","text":"有兔爰爰、雉離于罦。"},{"id":"p73510679ad9e-1","text":"我生之初、尚無造。"},{"id":"pb8134b2f8d8d-1","text":"我生之後、逢此百憂。"},{"id":"p925805bf3aa3-1","text":"尚寐無覺。"},{"id":"p24aec9e648ce-1","text":"有兔爰爰、雉離于罿。"},{"id":"p9f68fe54f920-1","text":"我生之初、尚無庸。"},{"id":"pfa3cd5d2805a-1","text":"我生之後、逢此百凶。"},{"id":"p4d9e338d5b2d-1","text":"尚寐無聰。"},{"id":"p76411b533982-1","text":"71.  葛藟"},{"id":"pe9dcde497d76-1","text":"綿綿葛藟、在河之滸。"},{"id":"p81d258dddd88-1","text":"終遠兄弟、謂他人父。"},{"id":"p550337c22b71-1","text":"謂他人父、亦莫我顧。"},{"id":"p7a5824187fd2-1","text":"綿綿葛藟、在河之涘。"},{"id":"pf2f678469f4d-1","text":"終遠兄弟、謂他人母。"},{"id":"pde955c890be8-1","text":"謂他人母、亦莫我有。"},{"id":"p3228bedff17d-1","text":"綿綿葛藟、在河之漘。"},{"id":"p302807d0e5ee-1","text":"終遠兄弟、謂他人昆。"},{"id":"p0d5cb67e1de9-1","text":"謂他人昆、亦莫我聞。"},{"id":"p92e673a8fc50-1","text":"72.  采葛"},{"id":"pc8c4be372090-1","text":"彼采葛兮。"},{"id":"pfc87798c8605-1","text":"一日不見、如三月兮。"},{"id":"p1312c2544b38-1","text":"彼采蕭兮。"},{"id":"pb5e7ba00c501-1","text":"一日不見、如三秋兮。"},{"id":"p32c106407eff-1","text":"彼采艾兮。"},{"id":"p5fd82182a67e-1","text":"一日不見、如三歲兮。"},{"id":"p698ac52fb410-1","text":"73.  大車"},{"id":"pc4c8857b74dc-1","text":"大車檻檻、毳衣如菼。"},{"id":"pa8051a0766a3-1","text":"豈不爾思、畏子不敢。"},{"id":"pca1584f133d0-1","text":"大車啍啍、毳衣如璊。"},{"id":"p89971c6a8858-1","text":"豈不爾思、畏子不奔。"},{"id":"pe8411d6ca71e-1","text":"穀則異室、死則同穴。"},{"id":"p31dbf59192ba-1","text":"謂予不信、有如皦日。"},{"id":"p75d2db7c53c3-1","text":"74.  丘中有麻"},{"id":"p648157bb3ad3-1","text":"丘中有麻、彼留子嗟。"},{"id":"p2e2777fdf6ec-1","text":"彼留子嗟、將其來施施。"},{"id":"pe14e4acb4337-1","text":"丘中有麥、彼留子國。"},{"id":"pe1458d0012e1-1","text":"彼留子國、將其來食。"},{"id":"pe346b77c3a27-1","text":"丘中有李、彼留之子。"},{"id":"pdbe6ee4f063e-1","text":"彼留之子、貽我佩玖。"},{"id":"p06aa509a5c10-1","text":"鄭風"},{"id":"pe8601ae641c8-1","text":"75.  緇衣"},{"id":"p2b185ec34fec-1","text":"緇衣之宜兮、敝、予又改為兮。"},{"id":"p799790820ea2-1","text":"適子之館兮、還、予授子之粲兮。"},{"id":"pc2a1710abe65-1","text":"緇衣之好兮、敝、予又改造兮。"},{"id":"p799790820ea2-2","text":"適子之館兮、還、予授子之粲兮。"},{"id":"p953c945518ba-1","text":"緇衣之蓆兮、敝、予又改作兮。"},{"id":"p799790820ea2-3","text":"適子之館兮、還、予授子之粲兮。"},{"id":"p2f966d874f1b-1","text":"76.  將仲子"},{"id":"p7406043802a6-1","text":"將仲子兮、無踰我里、無折我樹杞。"},{"id":"pddde5187ce60-1","text":"豈敢愛之、畏我父母。"},{"id":"pd42ce8f93d43-1","text":"仲可懷也、父母之言、亦可畏也。"},{"id":"p500d4ceb5bbd-1","text":"將仲子兮、無踰我墻、無折我樹桑。"},{"id":"p11fd31f359f3-1","text":"豈敢愛之、畏我諸兄。"},{"id":"p4c401abffab1-1","text":"仲可懷也、諸兄之言、亦可畏也。"},{"id":"p201e0137d9a2-1","text":"將仲子兮、無踰我園、無折我樹檀。"},{"id":"p2452a0f42314-1","text":"豈敢愛之、畏人之多言。"},{"id":"pbec896779f55-1","text":"仲可懷也、人之多言、亦可畏也。"},{"id":"p897221a97bfe-1","text":"77.  叔于田"},{"id":"pa64037d124ff-1","text":"叔于田、巷無居人。"},{"id":"p2d5085df9326-1","text":"豈無居人、不如叔也、洵美且仁。"},{"id":"pdb0be679836a-1","text":"叔于狩、巷無飲酒。"},{"id":"pb6cafaa430ed-1","text":"豈無飲酒、不如叔也、洵美且好。"},{"id":"p0ea6a5fca039-1","text":"叔適野、巷無服馬。"},{"id":"pc5d249abf544-1","text":"豈無服馬、不如叔也、洵美且武。"},{"id":"pedfb5003f3e8-1","text":"78.  大叔于田"},{"id":"pf2f814cc928f-1","text":"叔于田、乘乘馬、執轡如組、兩驂如舞。"},{"id":"pf5e71483d9a7-1","text":"叔在藪、火烈具舉。"},{"id":"p8622e7718913-1","text":"襢裼暴虎、獻于公所。"},{"id":"p753017a44394-1","text":"將叔無狃、戒其傷女。"},{"id":"p0e093652baeb-1","text":"叔于田、乘乘黃、兩服上襄、兩驂雁行。"},{"id":"p3950caf30994-1","text":"叔在藪、火烈具揚。"},{"id":"p31e0927a62a8-1","text":"叔善射忌、又良御忌、抑磬控忌、抑縱送忌。"},{"id":"p96c1f2aaaf08-1","text":"叔于田、乘乘鴇、兩服齊首、兩驂如手。"},{"id":"p9d800a67827c-1","text":"叔在藪、火烈具阜。"},{"id":"p5e03bd3a3a7e-1","text":"叔馬慢忌、叔發罕忌、抑釋掤忌、抑鬯弓忌。"},{"id":"pf9af700ebbce-1","text":"79.  清人"},{"id":"p34e5362eba1b-1","text":"清人在彭、駟介旁旁、二矛重英、河上乎翱翔。"},{"id":"p0ea451a52b5b-1","text":"清人在消、駟介麃麃、二矛重喬、河上乎逍遙。"},{"id":"p774c3f9e9d4a-1","text":"清人在軸、駟介陶陶、左旋右抽、中軍作好。"},{"id":"p7d0c4a05a27a-1","text":"80.  羔裘"},{"id":"p58112c3f497b-1","text":"羔裘如濡、洵直且侯。"},{"id":"p63229622b496-1","text":"彼其之子、舍命不渝。"},{"id":"p8241c137a6ea-1","text":"羔裘豹飾、孔武有力。"},{"id":"pd47d62a8947f-1","text":"彼其之子、邦之司直。"},{"id":"pd4e3fe0b6bed-1","text":"羔裘晏兮、三英粲兮。"},{"id":"p70cc5c25901b-1","text":"彼其之子、邦之彥兮。"},{"id":"pa5fee3b359f1-1","text":"81.  遵大路"},{"id":"p7de51b391bf4-1","text":"遵大路兮、摻執子之怯兮。"},{"id":"p419688b9b01e-1","text":"無我惡兮、不寁故也。"},{"id":"p80e1c77c0327-1","text":"遵大路兮、摻執子之手兮。"},{"id":"padaba44f8829-1","text":"無我醜兮、不寁好也。"},{"id":"p75485cf3bd0a-1","text":"82.  女曰雞鳴"},{"id":"p5deb8f781722-1","text":"女曰雞鳴、士曰昧旦。"},{"id":"p063ce602a2d6-1","text":"子興視夜、明星有爛。"},{"id":"p87559b9591d1-1","text":"將翱將翔、弋鳧與雁。"},{"id":"p7c82b086d34a-1","text":"弋言加之、與子宜之。"},{"id":"peb4273286cad-1","text":"宜言飲酒、與子偕老。"},{"id":"p158bfacf0700-1","text":"琴瑟在御、莫不靜好。"},{"id":"pc43d535eb139-1","text":"知子之來之、雜佩以贈之。"},{"id":"p3a9a39386202-1","text":"知子之順之、雜佩以問之。"},{"id":"pcfbae97944dd-1","text":"知子之好之、雜佩以報之。"},{"id":"p073ad48cf939-1","text":"83.  有女同車"},{"id":"p8102b78984e2-1","text":"有女同車、顏如舜華。"},{"id":"p77f59ed3f774-1","text":"將翱將翔、佩玉瓊琚。"},{"id":"pbc193960105a-1","text":"彼美孟姜、洵美且都。"},{"id":"pc9ad739639c0-1","text":"有女同行、顏如舜英。"},{"id":"pacedf572c343-1","text":"將翱將翔、佩玉將將。"},{"id":"pa2f2fb287fe3-1","text":"彼美孟姜、德音不忘。"},{"id":"pd42a5b3a18bd-1","text":"84.  山有扶蘇"},{"id":"p61dff0ae289a-1","text":"山有扶蘇、隰有荷華。"},{"id":"p2ace8e591fbe-1","text":"不見子都、乃見狂且。"},{"id":"p26be0f5f7ff7-1","text":"山有橋松、隰有游龍。"},{"id":"p8378ae6471d6-1","text":"不見子充、乃見狡童。"},{"id":"pa0d1715e6b27-1","text":"85.  蘀兮"},{"id":"pa1048aaececb-1","text":"蘀兮蘀兮、風其吹女。"},{"id":"p4d11aa7afdca-1","text":"叔兮伯兮、倡予和女。"},{"id":"pa5c42eeb7876-1","text":"蘀兮蘀兮、風其漂女。"},{"id":"p27506beed155-1","text":"叔兮伯兮、倡予要女。"},{"id":"pa9427d6b0aba-1","text":"86.  狡童"},{"id":"pe88ca37ce442-1","text":"彼狡童兮、不與我言兮。"},{"id":"pe752130a2944-1","text":"維子之故、使我不能餐兮。"},{"id":"p541ed577a64c-1","text":"彼狡童兮、不與我食兮。"},{"id":"pdec30f7c2885-1","text":"維子之故、使我不能息兮。"},{"id":"pa2f64c35863a-1","text":"87.  褰裳"},{"id":"p2fa3f385e7dd-1","text":"子惠思我、褰裳涉溱。"},{"id":"p0b596eee79bb-1","text":"子不我思、豈無他人。"},{"id":"p8c207d03faa8-1","text":"狂童之狂也且。"},{"id":"p9b5d175b6110-1","text":"子惠思我、褰裳涉洧。"},{"id":"p1dd6766375c1-1","text":"子不我思、豈無他士。"},{"id":"p8c207d03faa8-2","text":"狂童之狂也且。"},{"id":"p9934bd1decba-1","text":"88.  丰"},{"id":"pdc029882577b-1","text":"子之丰兮、俟我乎巷兮。"},{"id":"p8844f61e1e34-1","text":"悔予不送兮。"},{"id":"pf8373626d179-1","text":"子之昌兮、俟我乎堂兮。"},{"id":"p4e3bd3cc8d6e-1","text":"悔予不將兮。"},{"id":"p608e7febafeb-1","text":"衣錦褧裳、裳錦褧裳。"},{"id":"pd9ac5a89a4a6-1","text":"叔兮伯兮、駕予與行。"},{"id":"pa580d66f6980-1","text":"裳錦褧裳、衣錦褧衣。"},{"id":"p05fb9f60a94a-1","text":"叔兮伯兮、駕予與歸。"},{"id":"pa1ee7cae590d-1","text":"89.  東門之墠"},{"id":"pabf36ff22cf3-1","text":"東門之墠、茹藘在阪。"}]}