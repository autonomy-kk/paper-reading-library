{"bookId":"pg-23873","editionId":"c2bc819f6e13a1c2","chapterId":"c0003","paragraphs":[{"id":"p5a4739776a35-1","text":"春日遲遲、卉木萋萋。"},{"id":"p5e419b432dca-1","text":"倉庚喈喈、采蘩祁祁。"},{"id":"p402ec78ec2a1-1","text":"執訊獲醜、薄言還歸。"},{"id":"p4a599aff4e4c-1","text":"赫赫南仲、玁狁于夷。"},{"id":"p05fd588b16f8-1","text":"169.  杕杜"},{"id":"p4c19425d7bf2-1","text":"有杕之杜、有睆其實。"},{"id":"p05ba81b9be8c-1","text":"王事靡盬、繼嗣我日。"},{"id":"p4035e4ebe5f1-1","text":"日月陽止、女心傷止、征夫遑止。"},{"id":"p6c8a2b521f78-1","text":"有杕之杜、其葉萋萋。"},{"id":"p6078a414628f-1","text":"王事靡盬、我心傷悲。"},{"id":"pc766181b3549-1","text":"卉木萋止、女心悲止、征夫歸止。"},{"id":"pc37d21a3c47b-1","text":"陟彼北山、言采其杞。"},{"id":"pb990986882c8-1","text":"王事靡盬、憂我父母。"},{"id":"pdca704e6fa22-1","text":"檀車幝幝、四牡痯痯、征夫不遠。"},{"id":"pfb4008f43dee-1","text":"匪載匪來、憂心孔疚。"},{"id":"pdf737b9298bb-1","text":"期逝不至、而多為恤。"},{"id":"p22d95e51837f-1","text":"卜筮偕止、會言近止、征夫邇止。"},{"id":"p6be4fb393b9c-1","text":"南陔"},{"id":"pda5966a685b5-1","text":"笙詩無辭"},{"id":"p48f27434ccc9-1","text":"白華之什"},{"id":"p87ffa09153de-1","text":"白華"},{"id":"pda5966a685b5-2","text":"笙詩無辭"},{"id":"p58aa3e1a7abc-1","text":"華黍"},{"id":"pda5966a685b5-3","text":"笙詩無辭"},{"id":"p659b5dddac05-1","text":"170.  魚麗"},{"id":"p413eab29d0a7-1","text":"魚麗于罶、鱨鯊。"},{"id":"p1b6629e519cb-1","text":"君子有酒、旨且多。"},{"id":"pf61f84996e3a-1","text":"魚麗于罶、魴鱧。"},{"id":"p80aa121a7711-1","text":"君子有酒、多且旨。"},{"id":"p3055d3319d70-1","text":"魚麗于罶、鰋鯉。"},{"id":"p755efdc89517-1","text":"君子有酒、旨且有。"},{"id":"pb22089f23626-1","text":"物其多矣、維其嘉矣。"},{"id":"p794dd6a57f24-1","text":"物其旨矣、維其偕矣。"},{"id":"p8a5a3e4661ee-1","text":"物其有矣、維其時矣。"},{"id":"p502744b9b9d8-1","text":"由庚"},{"id":"pe72346bded0f-1","text":"笙詩無辭。"},{"id":"pd8cc8d2a54df-1","text":"171.  南有嘉魚"},{"id":"p5c4849ca99d4-1","text":"南有嘉魚、烝然罩罩。"},{"id":"p70c0bd4a70e9-1","text":"君子有酒、嘉賓式燕以樂。"},{"id":"p71d3befe5236-1","text":"南有嘉魚、烝然汕汕。"},{"id":"p7dcf80f79dcd-1","text":"君子有酒、嘉賓式燕以衎。"},{"id":"p7d52d4cfaa25-1","text":"南有樛木、 甘瓠纍之。"},{"id":"pc8b18d807f11-1","text":"君子有酒、嘉賓式燕綏之。"},{"id":"pf6a796f72918-1","text":"翩翩者鵻、烝然來思。"},{"id":"p797f73d96ef6-1","text":"君子有酒、嘉賓式燕又思。"},{"id":"p9ea7ea8e084c-1","text":"崇丘"},{"id":"pda5966a685b5-4","text":"笙詩無辭"},{"id":"p41abc6851b8c-1","text":"172.  南山有臺"},{"id":"p929f0b50a78d-1","text":"南山有臺、北山有萊。"},{"id":"p1b4cc4d90cdd-1","text":"樂只君子、邦家之基。"},{"id":"p6210d6e34447-1","text":"樂只君子、萬壽無期。"},{"id":"pe20b58da432c-1","text":"南山有桑、北山有楊。"},{"id":"p550cc024d13f-1","text":"樂只君子、邦家之光。"},{"id":"p7ee2aea1f679-1","text":"樂只君子、萬壽無疆。"},{"id":"p0f2f7a740578-1","text":"南山有杞、北山有李。"},{"id":"p246d4abb9df7-1","text":"樂只君子、民之父母。"},{"id":"p338831967ba8-1","text":"樂只君子、德音不已。"},{"id":"pd243e1aa87d3-1","text":"南山有栲、北山有杻。"},{"id":"p9cee4d4b75cf-1","text":"樂只君子、遐不眉壽。"},{"id":"p36988fd969be-1","text":"樂只君子、德音是茂。"},{"id":"pbc7beb445462-1","text":"南山有枸、北山有楰。"},{"id":"pf9ca27bb72c1-1","text":"樂只君子、遐不黃耇。"},{"id":"p5e1041a3ac54-1","text":"樂只君子、保艾爾後。"},{"id":"pbbace12ab335-1","text":"由儀"},{"id":"pa73db5d040cb-1","text":"無辭"},{"id":"p19ba620f0d91-1","text":"173.  蓼蕭"},{"id":"p7ada876ee092-1","text":"蓼彼蕭斯、零露湑兮。"},{"id":"pd7d851ae595b-1","text":"既見君子、我心寫兮。"},{"id":"p9dd857e3b5e9-1","text":"燕笑語兮、是以有譽處兮。"},{"id":"pea038fc6f41b-1","text":"蓼彼蕭斯、零露瀼瀼。"},{"id":"pe64e71ed666f-1","text":"既見君子、為龍為光。"},{"id":"p6f8f5060f537-1","text":"其德不爽、壽考不忘。"},{"id":"p7b806c6e3db4-1","text":"蓼彼蕭斯、零露泥泥。"},{"id":"p8f1a46f4713b-1","text":"既見君子、孔燕豈弟。"},{"id":"pcfdab4a2467e-1","text":"宜兄宜弟、令德壽豈。"},{"id":"p0ddc1d378688-1","text":"蓼彼蕭斯、零露濃濃。"},{"id":"p7e152bbac44e-1","text":"既見君子、鞗革沖沖。"},{"id":"paa7ccec0681a-1","text":"和鸞雝雝、萬福攸同。"},{"id":"p64726df9772c-1","text":"174.  湛露"},{"id":"p67f9dc1b5161-1","text":"湛湛露斯、匪陽不晞。"},{"id":"p04a4374bf8bb-1","text":"厭厭夜飲、不醉無歸。"},{"id":"p3eefe33c08f3-1","text":"湛湛露斯、在彼豐草。"},{"id":"p3867fb4d1012-1","text":"厭厭夜飲、在宗載考。"},{"id":"p24f630c38f43-1","text":"湛湛露斯、在彼杞棘。"},{"id":"pca38a6ff3afb-1","text":"顯允君子、莫不令德。"},{"id":"p48a33e79ef4f-1","text":"其實其椅、其實離離。"},{"id":"p9e9efe2c4819-1","text":"豈弟君子、莫不令儀。"},{"id":"pb97087762fd6-1","text":"彤弓之什"},{"id":"p9725e1fb09f0-1","text":"175.  彤弓"},{"id":"p9921c35eadfa-1","text":"彤弓弨兮、受言藏之。"},{"id":"p8e1bf14f62ac-1","text":"我有嘉賓、中心貺之。"},{"id":"p029d6469a039-1","text":"鐘鼓既設、一朝饗之。"},{"id":"p3f61e769ec9c-1","text":"彤弓弨兮、受言載之。"},{"id":"p7206d124e3c8-1","text":"我有嘉賓、中心喜之。"},{"id":"p60e7f5f7bd51-1","text":"鐘鼓既設、一朝右之。"},{"id":"pd980042c31e2-1","text":"彤弓弨兮、受言櫜之。"},{"id":"pc7a41f979cec-1","text":"我有嘉賓、中心好之。"},{"id":"pb74200f4b748-1","text":"鐘鼓既設、一朝酬之。"},{"id":"p71faddd94f6c-1","text":"176.  菁菁者莪"},{"id":"pa596f9191a88-1","text":"菁菁者莪、在彼中阿。"},{"id":"pf0c96127ef44-1","text":"既見君子、樂且有儀。"},{"id":"p296e7e0ef864-1","text":"菁菁者莪、在彼中沚。"},{"id":"pc7f21c31472e-1","text":"既見君子、我心則喜。"},{"id":"p243c5f24a0f8-1","text":"菁菁者莪、在彼中陵。"},{"id":"pb59322bf6953-1","text":"既見君子、錫我百朋。"},{"id":"pde3db2529f2c-1","text":"汎汎楊舟、載沉載浮。"},{"id":"p2da48dfeb31c-1","text":"既見君子、我心則休。"},{"id":"p2bfc03d97929-1","text":"177.  六月"},{"id":"p2fd836b1f4bb-1","text":"六月棲棲、戎車既飭。"},{"id":"p05cbff2c463f-1","text":"四牡騤騤、載是常服。"},{"id":"p3e7d666d904c-1","text":"玁狁孔熾、我是用急。"},{"id":"p6ae03fe4fd52-1","text":"王于出征、以匡王國。"},{"id":"pd02d703318ac-1","text":"比物四驪、閑之維則。"},{"id":"p642769ca7b5b-1","text":"維此六月、既成我服。"},{"id":"pcf637c46a3e8-1","text":"我服既成、于三十里。"},{"id":"pe9b40b5e4384-1","text":"王于出征、以佐天子。"},{"id":"pd43a4d3dbb42-1","text":"四牡脩廣、其大有顒。"},{"id":"pa0e3ccc49e59-1","text":"薄伐玁狁、以奏膚公。"},{"id":"p5096b5d8d29c-1","text":"有嚴有翼、共武之服。"},{"id":"p877e19831211-1","text":"共武之服、以定王國。"},{"id":"p4f760b2aa669-1","text":"玁狁匪茹、整居焦穫。"},{"id":"pe783050aba1a-1","text":"侵鎬及方、至于涇陽。"},{"id":"pe3e74c849072-1","text":"織文鳥章、白旆央央。"},{"id":"p7c74d05c5982-1","text":"元戎十乘、以先啟行。"},{"id":"peba7a3a1a16e-1","text":"戎車既安、如輊如軒。"},{"id":"pea99400efa2b-1","text":"四牡既佶、既佶且閑。"},{"id":"pd9dd3eca3283-1","text":"薄伐玁狁、至于大原。"},{"id":"pa468bd9f30ba-1","text":"文武吉甫、萬邦為憲。"},{"id":"pc185b26a8c8a-1","text":"吉甫燕喜、既多受祉。"},{"id":"pbd0a3ea1afd6-1","text":"來歸自鎬、我行永久。"},{"id":"p0626cc65c895-1","text":"飲御諸友、炰鱉膾鯉。"},{"id":"pa2e5b8f625d0-1","text":"侯誰在矣、張仲孝友。"},{"id":"p1a7c4e920330-1","text":"178.  采芑"},{"id":"p6e1f663776f4-1","text":"薄言采芑、于彼新田、于此菑畝。"},{"id":"pdfaab722c8a7-1","text":"方叔蒞止、其車三千、師干之試。"},{"id":"p2c5dd99da009-1","text":"方叔率止、乘其四騏、四騏翼翼。"},{"id":"p4ffa45a991a5-1","text":"路車有奭、簟笰魚服、鉤膺鞗革。"},{"id":"p95567c3a7d49-1","text":"薄言采芑、于彼新田、于此中鄉。"},{"id":"p608b7b5f5668-1","text":"方叔蒞止、其車三千、旂旐央央。"},{"id":"pc00c1063baaa-1","text":"方叔率止、約軝錯衡、八鸞瑲瑲。"},{"id":"pd6575f90b542-1","text":"服其命服、朱芾斯皇、有瑲蔥珩。"},{"id":"p7d3d830f3e2a-1","text":"鴥彼飛隼、其飛戾天、亦集爰止。"},{"id":"pdfaab722c8a7-2","text":"方叔蒞止、其車三千、師干之試。"},{"id":"p8f1f0622d393-1","text":"方叔率止、鉦人伐鼓、陳師鞠旅。"},{"id":"p542a8333d658-1","text":"顯允方叔、伐鼓淵淵、振旅闐闐。"},{"id":"pc77a52d09421-1","text":"蠢爾蠻荊、大邦為讎。"},{"id":"p0907086a0603-1","text":"方叔元老、克壯其猶。"},{"id":"p8457a31958fb-1","text":"方叔率止、執訊獲醜。"},{"id":"pa965059b9000-1","text":"戎車嘽嘽、嘽嘽焞焞、如霆如雷。"},{"id":"p3da0f4d2aecc-1","text":"顯允方叔、征伐玁狁、蠻荊來威。"},{"id":"pcd440f94b45a-1","text":"179.  車攻"},{"id":"p2054e9286cfe-1","text":"我車既攻、我馬既同。"},{"id":"p9a4342f16771-1","text":"四牡龐龐、駕言徂東。"},{"id":"p2cfd1344ec48-1","text":"田車既好、四牡孔阜。"},{"id":"pf1e9b3dbc6ea-1","text":"東有甫草、駕言行狩。"},{"id":"p795bf109cf95-1","text":"之子于苗、選徒囂囂。"},{"id":"p0f4803c0df78-1","text":"建旐設旄、搏獸于敖。"},{"id":"pfce360281103-1","text":"駕彼四牡、四牡奕奕。"},{"id":"p70a9190e82a9-1","text":"赤芾金舄、會同有繹。"},{"id":"p85aff09f8bbd-1","text":"決拾既佽、弓矢既調。"},{"id":"p54be81315546-1","text":"射夫既同、助我舉柴。"},{"id":"pe3684a2fb04c-1","text":"四黃既駕、兩驂不猗。"},{"id":"pd97a214ac045-1","text":"不失其馳、舍矢如破。"},{"id":"pf3b5796b6d12-1","text":"蕭蕭馬鳴、悠悠旆旌。"},{"id":"pdc1e6f9e8bbb-1","text":"徒御不驚、大庖不盈。"},{"id":"pe5bdf43094b3-1","text":"之子于征、有聞無聲。"},{"id":"pdb192700aae9-1","text":"允矣君子、展也大成。"},{"id":"p2eca3c33b9c5-1","text":"180.  吉日"},{"id":"pf6eef4c85136-1","text":"吉日維戊、既伯既禱。"},{"id":"p2cfd1344ec48-2","text":"田車既好、四牡孔阜。"},{"id":"p99688ddc7666-1","text":"升彼大阜、從其群醜。"},{"id":"pb55ce6dc6993-1","text":"吉日庚午、既差我馬。"},{"id":"p9e26141b29e9-1","text":"獸之所同、麀鹿麌麌。"},{"id":"pfcad80aacc8b-1","text":"漆沮子從、天子之所。"},{"id":"pa003438a0cce-1","text":"瞻彼中原、其祁孔有。"},{"id":"p396ada39a1a7-1","text":"儦儦俟俟、或群或友。"},{"id":"pa810d9b5b68b-1","text":"悉率左右、以燕天子。"},{"id":"p51ad377764ff-1","text":"既張我弓、既挾我矢。"},{"id":"pff421b1def29-1","text":"發彼小豝、殪此大兕。"},{"id":"p6d1352fd51a3-1","text":"以御賓客、且以酌醴。"},{"id":"p611d5fa67674-1","text":"181.  鴻雁"},{"id":"p477586037477-1","text":"鴻雁于飛、肅肅其羽。"},{"id":"pba7afcdf438d-1","text":"之子于征、劬勞于野。"},{"id":"pfd2f0193eddf-1","text":"爰及矜人、哀此鰥寡。"},{"id":"p3fa3fc19c0e3-1","text":"鴻雁于飛、集于中澤。"},{"id":"pac904f8e3ef3-1","text":"之子于垣、百堵皆作。"},{"id":"p03feb8218084-1","text":"雖則劬勞、其究安宅。"},{"id":"p1c033561aed7-1","text":"鴻雁于飛、哀鳴嗷嗷。"},{"id":"p2519ba1b636a-1","text":"維此哲人、謂我劬勞。"},{"id":"p7bfaa6e61597-1","text":"維彼愚人、謂我宣驕。"},{"id":"p7152329e360c-1","text":"182.  庭燎"},{"id":"peb1fafb2aa65-1","text":"夜如何其、夜未央、庭燎之光。"},{"id":"p68355cb69558-1","text":"君子至止、鸞聲將將。"},{"id":"p23df65894ed3-1","text":"夜如何其、夜未艾、庭燎晢晢。"},{"id":"p8ec48f811b49-1","text":"君子至止、鸞聲噦噦。"},{"id":"pb5e67a2c3dc1-1","text":"夜如何其、夜鄉晨、庭燎有輝。"},{"id":"p902dcea647d0-1","text":"君子至止、言觀其旂。"},{"id":"p0cc3bf3507a3-1","text":"183.  沔水"},{"id":"pce20579e3121-1","text":"沔彼流誰、朝宗于海。"},{"id":"p9e1c4d864926-1","text":"鴥彼飛隼、載飛載止。"},{"id":"pf1738232fc03-1","text":"嗟我兄弟、邦人諸友、莫肯念亂、誰無父母。"},{"id":"p9f806a302040-1","text":"沔彼流水、其流湯湯。"},{"id":"peb44a470f482-1","text":"鴥彼飛隼、載飛載揚。"},{"id":"pdfcca3899ac1-1","text":"念彼不蹟、載起載行。"},{"id":"p3177f8670d4a-1","text":"心之憂矣、不可弭忘。"},{"id":"p177fa5c81030-1","text":"鴥彼飛隼、率彼中陵。"},{"id":"p45528a10e550-1","text":"民之訛言、寧莫之懲。"},{"id":"p4c8f6699df29-1","text":"我友敬矣、讒言其興。"},{"id":"pbbe59f404d75-1","text":"184.  鶴鳴"},{"id":"p35e1eaefd4e1-1","text":"鶴鳴于九皋、聲聞于野。"},{"id":"pe8ec80b74651-1","text":"魚潛在淵、或在于渚。"},{"id":"p42408ec44e63-1","text":"樂彼之園、爰有樹檀、其下維蘀。"},{"id":"pc28c9582db91-1","text":"它山之石、可以為錯。"},{"id":"p51456041c957-1","text":"鶴鳴于九皋、聲聞于天。"},{"id":"pe149bd21f458-1","text":"魚在于渚、或潛在淵。"},{"id":"p739ff2eaa9f9-1","text":"樂彼之園、爰有樹檀、其下維?c。"},{"id":"p32d8cb47f387-1","text":"它山之石、可以攻玉。"},{"id":"p3d42c475cfa1-1","text":"祈父之什"},{"id":"pc193eff1d144-1","text":"185.  祈父"},{"id":"p675e6efcbcbb-1","text":"祈父、予王之爪牙。"},{"id":"p8cbd849e2b56-1","text":"胡轉予于恤、靡所止居。"},{"id":"p6efdfad60bc1-1","text":"祈父、予王之爪士。"},{"id":"pfaaef4d2caba-1","text":"胡轉予于恤、靡所底止。"},{"id":"p3dd26795dcf4-1","text":"祈父、亶不聰。"},{"id":"p067d36358cc3-1","text":"胡轉予于恤、有母之尸饔。"},{"id":"pb129884d2371-1","text":"186.  白駒"},{"id":"pc2165c1630d9-1","text":"皎皎白駒、食我場苗。"},{"id":"pb26f1aad55a0-1","text":"縶之維之、以永今朝。"},{"id":"pb2b6bff9fcb5-1","text":"所謂伊人、於焉逍遙。"},{"id":"p69d6128ab2aa-1","text":"皎皎白駒、食我場藿。"},{"id":"pd6c476fedb0e-1","text":"縶之維之、以永今夕。"},{"id":"p0e28f1d06ec4-1","text":"所謂伊人、於焉嘉客。"},{"id":"p87e53416cbc1-1","text":"皎皎白駒、賁然來思。"},{"id":"p55536b246baa-1","text":"爾公爾侯、逸豫無期。"},{"id":"p8f6a8dd450ec-1","text":"慎爾優遊、勉爾遁思。"},{"id":"p7c402d20ada8-1","text":"皎皎白駒、在彼空谷。"},{"id":"pa47cbfe33c8f-1","text":"生芻一束、其人如玉。"},{"id":"p236ebf0777f7-1","text":"毋金玉爾音、而有遐心。"},{"id":"p7885499bb456-1","text":"187.  黃鳥"},{"id":"pf242c9096eee-1","text":"黃鳥黃鳥。"},{"id":"p6949184de05c-1","text":"無集于穀。"},{"id":"p92e81430ff41-1","text":"無啄無粟。"},{"id":"p090ccdd9e484-1","text":"此邦之人。"},{"id":"p9b6472f5fcdf-1","text":"不我肯穀。"},{"id":"pe9868148c7ba-1","text":"言旋言歸。"},{"id":"p319d3d46e176-1","text":"復我邦族。"},{"id":"pf242c9096eee-2","text":"黃鳥黃鳥。"},{"id":"pb2028bc68234-1","text":"無集于桑。"},{"id":"p6b1df92ebe01-1","text":"無啄我粱。"},{"id":"p090ccdd9e484-2","text":"此邦之人。"},{"id":"p2b10229c9541-1","text":"不可與明。"},{"id":"pe9868148c7ba-2","text":"言旋言歸。"},{"id":"p8455fadadac2-1","text":"復我諸兄。"},{"id":"pf242c9096eee-3","text":"黃鳥黃鳥。"},{"id":"p22823eab1cef-1","text":"無集于栩。"},{"id":"p26f8bd897149-1","text":"無啄我黍。"},{"id":"p090ccdd9e484-3","text":"此邦之人。"},{"id":"pc8a818ba866f-1","text":"不可與處。"},{"id":"pe9868148c7ba-3","text":"言旋言歸。"},{"id":"pa37102578a17-1","text":"復我諸父。"},{"id":"p0117747f6ed9-1","text":"188.  我行其野"},{"id":"pddbf8180092a-1","text":"我行其野、蔽芾其樗。"},{"id":"p8125211d4aca-1","text":"婚姻之故、言就爾居。"},{"id":"p16698f7b62fd-1","text":"爾不我畜、復我邦家。"},{"id":"p3b9a61f5ff17-1","text":"我行其野、言采其蓫。"},{"id":"p7519b4e8b301-1","text":"婚姻之故、言就爾宿。"},{"id":"p335ea04eec49-1","text":"爾不我畜、言歸思復。"},{"id":"p82c1ce3a50f4-1","text":"我行其野、言采其葍。"},{"id":"pc97b83517d95-1","text":"不思舊姻、求爾新特。"},{"id":"p6649f90498e4-1","text":"成不以富、亦祇以異。"},{"id":"pe2f342799c3a-1","text":"189.  斯干"},{"id":"p3c979836a66f-1","text":"秩秩斯干、幽幽南山。"},{"id":"p696f9be1c79d-1","text":"如竹苞矣、如松茂矣。"},{"id":"ped4fbdd77c4f-1","text":"兄及弟矣、式相好矣、無相猶矣。"},{"id":"p6337496caf1e-1","text":"似續妣祖、築室百堵、西南其戶。"},{"id":"p121e8ca117be-1","text":"爰居爰處、爰笑爰語。"},{"id":"pf514411e0f5c-1","text":"約之閣閣、椓之橐橐。"},{"id":"pf2dcd802201e-1","text":"風雨攸除、鳥鼠攸去、君子攸芋。"},{"id":"p9ee8c427a3f4-1","text":"如跂斯翼、如矢斯棘、如鳥斯革。"},{"id":"pe2ab485f9ea4-1","text":"如翬斯飛、君子攸躋。"},{"id":"p6c26285ace8a-1","text":"殖殖其庭、有覺其楹、噲噲其正、噦噦其冥、君子攸寧。"},{"id":"p0cabb1331b59-1","text":"下莞上簟、乃安斯寢。"},{"id":"paca9db0465d8-1","text":"乃寢乃興、乃占我夢。"},{"id":"paa8d72530d5e-1","text":"吉夢維何、維熊維羆、 維虺維蛇。"},{"id":"pc07b14d2be79-1","text":"大人占之。"},{"id":"pb12a51af91f4-1","text":"維熊維羆、男子之祥。"},{"id":"p040f62ea774d-1","text":"維虺維蛇、女子之祥。"},{"id":"p29cb2ffd9342-1","text":"乃生男子、載寢之床、載衣之裳、載弄之璋。"},{"id":"p13984817cdfc-1","text":"其泣喤喤、朱芾斯皇、室家君王。"},{"id":"p9b3ba564c645-1","text":"乃生女子、載寢之地、載衣之裼、 載弄之瓦。"},{"id":"p3666d47c790a-1","text":"無非無儀、唯酒食是議、無父母詒罹。"},{"id":"p4179b4c72ea1-1","text":"190.  無羊"},{"id":"p4745a59a7d56-1","text":"誰謂爾無羊、三百維群。"},{"id":"p952ed7639e32-1","text":"誰謂爾無牛、九十其犉。"},{"id":"p59e80af4b5ca-1","text":"爾羊來思、其角濈濈。"},{"id":"p7cdb038681fc-1","text":"爾牛來思、其耳濕濕。"},{"id":"pc2d06d5cc245-1","text":"或降于阿、或飲于池、或寢于訛。"},{"id":"p10b4b7e9d775-1","text":"爾牧來思、何蓑何笠、或負其餱。"},{"id":"p19aed932f095-1","text":"三十維物、爾牲則具。"},{"id":"p4cba8588f853-1","text":"爾牧來思、以薪以蒸、以雌以雄。"},{"id":"p4a9df529177c-1","text":"爾羊來思、矜矜兢兢、不騫不崩。"},{"id":"pdca035ede9d4-1","text":"麾之以肱、畢來既升。"},{"id":"pa8afe61b2a9f-1","text":"牧人乃夢、眾維魚矣、旐維旟矣。"},{"id":"pea262752b8b7-1","text":"大人占之、眾維魚矣、實維豐年。"},{"id":"p895c167073e9-1","text":"旐維旟矣、室家溱溱。"},{"id":"p1326dd72112b-1","text":"191.  節南山"},{"id":"pa9e3512700b9-1","text":"節彼南山、維石巖巖。"},{"id":"p11dbfc5197e2-1","text":"赫赫師尹、民具爾瞻。"},{"id":"p7555ee026746-1","text":"憂心如惔、不敢戲談。"},{"id":"p541c2979b6d6-1","text":"國既卒斬、何用不監。"},{"id":"pd7e3652eb9f0-1","text":"節彼南山、有實其猗。"},{"id":"pdf3cd61345a3-1","text":"赫赫師尹、不平謂何。"},{"id":"p19f511cc8282-1","text":"天方薦瘥、喪亂弘多。"},{"id":"pc3564769fa1f-1","text":"民言無嘉、憯莫懲嗟。"},{"id":"p7af759d91ac7-1","text":"尹氏大師、維周之氏。"},{"id":"pa2c3a26e4d8a-1","text":"秉國之均、四方是維。"},{"id":"p5ff90a29ff87-1","text":"天子是毗、俾民不迷。"},{"id":"p7302d8deb832-1","text":"不弔昊天、不宜空我師。"},{"id":"p86fcf3e53540-1","text":"弗躬弗親、庶民弗信。"},{"id":"p3dd578f9752d-1","text":"弗問弗仕、勿罔君子。"},{"id":"pc4e386e77917-1","text":"式夷式已、無小人殆。"},{"id":"p203d0d913d48-1","text":"瑣瑣姻亞、則無膴仕。"},{"id":"p96c1ef0d46ae-1","text":"昊天不傭、降此鞠 。"},{"id":"p1a06bceea828-1","text":"昊天不惠、降此大戾。"},{"id":"p5fe74d31f4a7-1","text":"君子如屆、俾民心闋。"},{"id":"p4144d04d6705-1","text":"君子如夷、惡怒是違。"},{"id":"p4aaa6ea71900-1","text":"不弔昊天、亂靡有定。"},{"id":"p8b18fa101994-1","text":"式月斯生、俾民不寧。"},{"id":"pb9ad3bd756c0-1","text":"憂心如酲、誰秉國成。"},{"id":"p8e8228742721-1","text":"不自為政、卒勞百姓。"},{"id":"pe6b00601f971-1","text":"駕彼四牡、四牡項領。"},{"id":"p54214a1913a7-1","text":"我瞻四方、蹙蹙靡所騁。"},{"id":"pcca2c9e80e36-1","text":"方茂爾惡、相爾矛矣。"},{"id":"p8e3198666dda-1","text":"既夷既懌、如相酬矣。"},{"id":"p80ad5b0a6c1b-1","text":"昊天不平、我王不寧。"},{"id":"p358d1104fc73-1","text":"不懲其心、覆怨其正。"},{"id":"pac1263d6f5c8-1","text":"家父作誦、以究王  。"},{"id":"p9e087bdde2ac-1","text":"式訛爾心、以畜萬邦。"},{"id":"p41391ca08b04-1","text":"192.  正月"},{"id":"pc1c4bc3a3049-1","text":"正月繁霜、我心憂傷。"},{"id":"p328c0c50c0f7-1","text":"民之訛言、亦孔之將。"},{"id":"pf86238b0d4a4-1","text":"念我獨兮、憂心京京。"},{"id":"pb0852c27789c-1","text":"哀我小心、癙憂以痒。"},{"id":"pe07491ce322c-1","text":"父母生我、胡俾我瘉。"},{"id":"p81ff6e9abe2c-1","text":"不自我先、不自我後。"},{"id":"p0d635ee17e28-1","text":"好言自口、莠言自口。"},{"id":"p1678c7a96b92-1","text":"憂心愈愈、是以有侮。"},{"id":"p57749dd15d8d-1","text":"憂心惸惸、念我無祿。"},{"id":"p0e456c5b4e7f-1","text":"民之無辜、并其臣僕。"},{"id":"p049a8a3f245c-1","text":"哀我人斯、于何從祿。"},{"id":"p8d2d61017ae5-1","text":"瞻烏爰止、于誰之屋。"},{"id":"p8e5c6e41a364-1","text":"瞻彼中林、侯薪猴蒸。"},{"id":"pf25e57667c3f-1","text":"民今方殆、視天夢夢。"},{"id":"p7cf0bc8fd8bc-1","text":"既克有定、靡人弗勝。"},{"id":"p31d100c812a7-1","text":"有皇上帝、伊誰云憎。"},{"id":"p9f4e9ad97e32-1","text":"謂山蓋卑、為岡為陵。"},{"id":"p45528a10e550-2","text":"民之訛言、寧莫之懲。"},{"id":"p28edd108a1b9-1","text":"召彼故老、訊之占夢。"},{"id":"pc5ad0b2581c0-1","text":"具曰予聖、誰知烏之雌雄。"},{"id":"p434e37a86698-1","text":"謂天蓋高、不敢不局。"},{"id":"pf2f46fe69da8-1","text":"謂地蓋厚、不敢不蹐。"},{"id":"p2116009b32ae-1","text":"維號斯言、有倫有脊。"},{"id":"p1dc3add29047-1","text":"哀今之人、胡為虺蜴。"},{"id":"p0f1c3e4af561-1","text":"瞻彼阪田、有菀其特。"},{"id":"p3f438e5af391-1","text":"天之扤我、如不我克。"},{"id":"p7b71b41dc825-1","text":"彼求我則、如不我得。"},{"id":"pc8a010d94700-1","text":"執我仇仇、亦不我力。"},{"id":"pd0a8b9525775-1","text":"心之憂矣、如或結之。"},{"id":"p4d713455d922-1","text":"今茲之正、胡然厲矣。"},{"id":"pbab37fd680bb-1","text":"燎之方揚、寧或滅之。"},{"id":"p7b780a965e30-1","text":"赫赫周宗、褒姒滅之。"},{"id":"p95c55ce00ad4-1","text":"終其永懷、又窘陰雨。"},{"id":"p4065b7ff4d05-1","text":"其車既載、乃棄爾輔。"},{"id":"p349450999133-1","text":"載輸爾載、 將伯助予。"},{"id":"p4db6ac0b775b-1","text":"無棄爾輔、員于爾輻。"},{"id":"pf4ab8b568da5-1","text":"屢顧爾僕、不輸爾載。"},{"id":"p3d41d401c9a0-1","text":"終踰絕險、曾是不意。"},{"id":"pbec1a6d57f43-1","text":"魚在于沼、亦匪克樂。"},{"id":"p3ae92c170785-1","text":"潛雖伏矣、亦孔之炤。"},{"id":"pf154db282cac-1","text":"憂心慘慘、念國之為虐。"},{"id":"pc4bb7d275125-1","text":"彼有旨酒、又有嘉殽。"},{"id":"pcbd58098ef80-1","text":"洽比其鄰、昏姻孔云。"},{"id":"p98354aac8d4c-1","text":"念我獨兮、憂心慇慇。"},{"id":"pa53bc9c349e7-1","text":"佌佌彼有屋、蔌蔌方有穀。"},{"id":"p910fd606ef6d-1","text":"民今之無祿、天夭是椓。"},{"id":"p21b5fa6ed749-1","text":"哿矣富人、哀此惸獨。"},{"id":"p0c799203bbd3-1","text":"193.  十月之交"},{"id":"p6961885be7d0-1","text":"十月之交、朔日辛卯。"},{"id":"pd9b4b7efc506-1","text":"日有食之、亦孔之醜。"},{"id":"peebb8662b2e5-1","text":"彼月而微、此日而微。"},{"id":"p4976519d52ec-1","text":"今此下民、亦孔之哀。"},{"id":"p12fe08c1914c-1","text":"日月告凶、不用其行。"},{"id":"p1bc98293d61e-1","text":"四國無政、不用其良。"},{"id":"p1c39f2f28919-1","text":"彼月而食、則維其常。"},{"id":"pe882030613e3-1","text":"此日而食、于何不臧。"},{"id":"p04075646e1e7-1","text":"燁燁震電、不寧不令。"},{"id":"p9e22e6b4cd96-1","text":"百川沸騰、山冢崒崩。"},{"id":"pd88fb0a19b61-1","text":"高岸為谷、深谷為陵。"},{"id":"pdf555dca89c3-1","text":"哀今之人、胡憯莫懲。"},{"id":"pf2ea5de81efd-1","text":"皇父卿士。"},{"id":"p3a530ff10bbf-1","text":"番維司徒。"},{"id":"p54d2a0bda82c-1","text":"家伯維宰。"},{"id":"p1149429e54ca-1","text":"仲允膳夫。"},{"id":"pbd2a5443d945-1","text":"棸子內史。"},{"id":"pc7944019efa1-1","text":"蹶維趣馬。"},{"id":"p4b750e13fd83-1","text":"楀維師氏。"},{"id":"pbd86103f34e0-1","text":"豔妻煽方處。"},{"id":"p8008271e0f67-1","text":"抑此皇父、豈曰不時。"},{"id":"p948245b5c688-1","text":"胡為我作、不即我謀。"},{"id":"p5c89f02c469d-1","text":"徹我牆屋、田卒汙萊。"},{"id":"pff890cab11ac-1","text":"曰予不戕、禮則然矣。"},{"id":"p646c551b3669-1","text":"皇父孔聖、作都于向。"},{"id":"p23da0ec2bd23-1","text":"擇三有事、亶侯多藏。"},{"id":"p64f6e65d7a91-1","text":"不憖遺一老、俾守我王。"},{"id":"pfd1f7f9a4f67-1","text":"擇有車馬、以居徂向。"},{"id":"pe472eea898af-1","text":"黽勉從事、不敢告勞。"},{"id":"p35a4eae36ba5-1","text":"無罪無辜、讒口囂囂。"},{"id":"p651ef2657137-1","text":"下民之孽、匪降自天。"},{"id":"p17607697d2ab-1","text":"噂沓背憎、職競由人。"},{"id":"p9eda97450aeb-1","text":"悠悠我里、亦孔之痗。"},{"id":"p7a48a7c36ad7-1","text":"四方有羨、我獨居憂。"},{"id":"pac9e139947fc-1","text":"民莫不逸、我獨不敢休。"},{"id":"p94e2c01bc7bf-1","text":"天命不徹、我不敢傚我友自逸。"},{"id":"pa32c0fc196ef-1","text":"194.  雨無正"},{"id":"p482073b19236-1","text":"浩浩昊天、不駿其德。"},{"id":"pf7e6dad8514d-1","text":"降喪飢饉、斬伐四國。"},{"id":"pba21370623f4-1","text":"旻天疾威、弗盧弗圖。"},{"id":"p73703cdfccd5-1","text":"舍彼有罪、既伏其辜。"},{"id":"p39dae2c31376-1","text":"若此無罪、淪胥以鋪。"},{"id":"pd6e859b2a686-1","text":"周宗既滅、靡所止戾。"},{"id":"p96ebcf6cc964-1","text":"正大夫離居、莫知我勩。"},{"id":"p633017071b3c-1","text":"三事大夫、莫肯夙夜。"},{"id":"pd9d165260cd9-1","text":"邦君諸侯、莫肯朝夕。"},{"id":"pef2ee52b8a71-1","text":"庶曰式臧、覆出為惡。"},{"id":"p02dbefd46545-1","text":"如何昊天。"},{"id":"p51e20bd8e318-1","text":"辟言不信。"},{"id":"pea79d19f042a-1","text":"如彼行邁、則靡所臻。"},{"id":"pc049d19880a9-1","text":"凡百君子、各敬爾身。"},{"id":"pcb4c74b956f5-1","text":"胡不相畏、不畏于天。"},{"id":"p2e198dba6fb7-1","text":"戎成不退、飢成不遂。"},{"id":"p552f412f9a96-1","text":"曾我御、憯憯日瘁。"},{"id":"p6494fc62087e-1","text":"凡百君子、莫肯用訊。"},{"id":"pda4eac5a2856-1","text":"聽言則答、譖言則退。"},{"id":"p3dcd93f387f5-1","text":"哀哉不能言、匪舌是出、維躬是瘁。"},{"id":"p9432e0db2bc1-1","text":"哿矣能言、巧言如流、俾躬處休。"},{"id":"pac0227aee57d-1","text":"維曰于仕、孔棘且殆。"},{"id":"p49257d2acb1a-1","text":"云不可使、得罪于天子。"},{"id":"p88dc2f6128ba-1","text":"亦云可使、怨及朋友。"},{"id":"p2686becbd223-1","text":"謂爾遷于王都、曰予未有室家。"},{"id":"p4186ef906a6e-1","text":"鼠思泣血、無言不疾。"},{"id":"p273b58e3e732-1","text":"昔爾出居、誰從作爾室。"},{"id":"pa68637275af7-1","text":"小旻之什"},{"id":"pddff22eed98f-1","text":"195.  小旻"},{"id":"pe38b61eba8ee-1","text":"旻天疾威、敷于下土。"},{"id":"p7fd93adb05e1-1","text":"謀猶回遹、何日斯沮。"},{"id":"p3e4902f54bbc-1","text":"謀臧不從、不臧覆用。"},{"id":"pc12a9215ae70-1","text":"我視謀猶、亦孔之邛。"},{"id":"pf0ba02854664-1","text":"潝潝訿訿、亦孔之哀。"},{"id":"p94f9228a29b7-1","text":"謀之其臧、則具是違。"},{"id":"pb9357f2bba02-1","text":"謀之不臧、則具是依。"},{"id":"peed5626fa28d-1","text":"我視謀猶、伊于胡底。"},{"id":"pc4060291b03a-1","text":"我龜既厭、不我告猶。"},{"id":"pe3e748ecfe51-1","text":"謀夫孔多、是用不集。"},{"id":"p80332b364021-1","text":"發言盈庭、誰敢執其咎。"},{"id":"pe880f300b0b3-1","text":"如匪行邁謀、是用不得于道。"},{"id":"pd8f25258890f-1","text":"哀哉為猶、匪先民是程、匪大猶是經、維邇言是聽、維邇言是爭。"},{"id":"pda1e3e1b4897-1","text":"如彼築室于道謀、是用不潰于成。"},{"id":"p501be752a7cf-1","text":"國雖靡止、或聖或否。"},{"id":"pb2cef62ffa7e-1","text":"民雖靡膴、或哲或謀、或肅或艾。"},{"id":"pf0cbee80033d-1","text":"如彼泉流、無淪胥以敗。"},{"id":"pd901ffe60108-1","text":"不敢暴虎、不敢馮河。"},{"id":"p4669a6926a7b-1","text":"人知其一、莫知其它。"},{"id":"p8583fa3086c4-1","text":"戰戰兢兢、如臨深淵、如履薄冰。"},{"id":"pe3e0e99ebd7e-1","text":"196.  小宛"},{"id":"pc4524a0baa0e-1","text":"宛彼鳴鳩、翰飛戾天。"},{"id":"pf7baf460e190-1","text":"我心憂傷、念昔先人。"},{"id":"peccc2755d58f-1","text":"明發不寐、有懷二人。"},{"id":"pc808aca2337e-1","text":"人之齊聖、飲酒溫克。"},{"id":"pb1f74d2941ea-1","text":"彼昏不知、壹醉日富。"},{"id":"p017f03083bb2-1","text":"各敬爾儀、天命不又。"},{"id":"pc92dab0bdf45-1","text":"中原有菽、庶民采之。"},{"id":"p4bcc25908093-1","text":"螟蛉有子、蜾蠃負之。"},{"id":"pef77ce5d6cb6-1","text":"教誨爾子、式穀似之。"},{"id":"pbc3c562b4420-1","text":"題彼脊令、載飛載鳴。"},{"id":"p9a6d235fb47c-1","text":"我日斯邁、而月斯征。"},{"id":"p5102869053fd-1","text":"夙興夜寐、無忝爾所生。"},{"id":"p6b98d40555db-1","text":"交交桑扈、率場啄粟。"},{"id":"p8e5491c314d0-1","text":"哀我填寡、宜岸宜獄。"},{"id":"p6befb9b643ea-1","text":"握粟出卜、自何能穀。"},{"id":"p72c8c390c79f-1","text":"溫溫恭人、如集于木。"},{"id":"p827e52adf798-1","text":"惴惴小心、如臨于谷。"},{"id":"pe2630ec8d02b-1","text":"戰戰兢兢、如履薄冰。"},{"id":"p68abb2e182bf-1","text":"197.  小弁"},{"id":"p42826c68267c-1","text":"弁彼鸒斯、歸飛提提。"},{"id":"p10f608c9241a-1","text":"民莫不穀、我獨于罹。"},{"id":"pd50a6cc77be2-1","text":"何辜于天、我罪伊何。"},{"id":"p869a2e57e866-1","text":"心之憂矣、云如之何。"},{"id":"p6b24dbf5a7a9-1","text":"踧踧周道、鞫為茂草。"},{"id":"p0f99600e8678-1","text":"我心憂傷、惄焉如擣。"},{"id":"p2d79de9d4a47-1","text":"假寐永嘆、維憂用老。"},{"id":"pc299a1ab8374-1","text":"心之憂矣、疢如疾首。"},{"id":"pe4e6f08d07e0-1","text":"維桑與梓、必恭敬止。"},{"id":"pb26fa4efde3c-1","text":"靡瞻匪父、靡依匪母。"},{"id":"p00cec7cadec9-1","text":"不屬于毛、不離于裹。"},{"id":"pe1fd6f2658c8-1","text":"天之生我、我辰安在。"},{"id":"p0d8e46fcb99d-1","text":"菀彼柳斯、鳴蜩嘒嘒。"},{"id":"pca32c4377478-1","text":"有凗者淵、萑葦淠淠。"},{"id":"p63c98dd4f24d-1","text":"譬彼舟流、不知所屆。"},{"id":"pa4ae12aa9e03-1","text":"心之憂矣、不遑假寐。"},{"id":"p3df1bba95de0-1","text":"鹿斯之奔、維足伎伎。"},{"id":"pb0a445982523-1","text":"雉之朝雊、尚求其雌。"},{"id":"p9ffdaf101c31-1","text":"譬彼壞木、疾用無枝。"},{"id":"p16497235905a-1","text":"心之憂矣、寧莫之知。"},{"id":"p3d17910de71b-1","text":"相彼投兔、尚或先之。"},{"id":"p13c2a11ba0e1-1","text":"行有死人、尚或墐之。"},{"id":"p88d89ae5c3bc-1","text":"君子秉心、維其忍之。"},{"id":"pf1459b2a29ec-1","text":"心之憂矣、涕既隕之。"},{"id":"pccfbe20aeb13-1","text":"君子信讒、如或酬之。"},{"id":"pb10a16bd596c-1","text":"君子不惠、不舒究之。"},{"id":"p98d79a3a4187-1","text":"伐木掎矣、析薪杝矣。"},{"id":"peace14c97857-1","text":"舍彼有罪、予之佗矣。"},{"id":"p99a635135737-1","text":"莫高匪山、莫浚匪泉。"},{"id":"pdd2ccfe634b1-1","text":"君子無易由言、耳屬于垣。"},{"id":"p3a5ff1bccabd-1","text":"無逝我梁、無發我笱。"},{"id":"p3be754a94013-1","text":"我躬不閱、遑恤我後。"},{"id":"p07dcf5cd4e36-1","text":"198.  巧言"},{"id":"p971a5eea833d-1","text":"悠悠昊天、曰父母且。"},{"id":"p18b84f2ace2c-1","text":"無罪無辜、亂如此憮。"},{"id":"pad9c8db51ad2-1","text":"昊天已威、予慎無罪。"},{"id":"p1d54e580d809-1","text":"昊天泰憮、予慎無辜。"},{"id":"p65f81323f562-1","text":"亂之初生、僭始既涵。"},{"id":"p1f427aed77c1-1","text":"亂之又生、君子信讒。"},{"id":"p54567539bde0-1","text":"君子如怒、亂庶遄沮。"},{"id":"p63240a46d5e6-1","text":"君子如祉、亂庶遄已。"},{"id":"p840b2a1cd8c2-1","text":"君子屢盟、亂是用長。"},{"id":"p1094f19b83ea-1","text":"君子信盜、亂是用暴。"},{"id":"p15ccb24a9bb2-1","text":"盜言孔甘、亂是用餤。"},{"id":"pd8455111c800-1","text":"匪其止共、維王之邛。"},{"id":"p4a8c83f82be1-1","text":"奕奕寢廟、君子作之。"},{"id":"p9f670a4b86ea-1","text":"秩秩大猷、聖人莫之。"},{"id":"pee7474ae9a37-1","text":"他人有心、予忖度之。"},{"id":"p27e54562bd10-1","text":"躍躍毚兔、遇犬獲之。"},{"id":"p08a1cc9b8cd0-1","text":"荏染柔木、君子樹之。"},{"id":"p3a20d9e539a8-1","text":"往來行言、心焉數之。"},{"id":"pd9ed5fbabaa4-1","text":"蛇蛇碩言、出自口矣。"},{"id":"pebc25de7b19b-1","text":"巧言如簧、顏之厚矣。"},{"id":"p5f7caf213986-1","text":"彼何人斯、居河之麋。"},{"id":"p6ad933245173-1","text":"無拳無勇、職為亂階。"},{"id":"p9285016e6572-1","text":"既微且尰、爾勇伊何。"},{"id":"p651431c0700b-1","text":"為猶將多、爾居徒幾何。"},{"id":"p1d65ebad7854-1","text":"199.  何人斯"},{"id":"ped6ab6bfe517-1","text":"彼何人斯、其心孔艱。"},{"id":"pf910f515b0c8-1","text":"胡逝我梁、不入我門。"},{"id":"p926d5359b102-1","text":"伊誰云從、維暴之云。"},{"id":"pe187e3f0795b-1","text":"二人從行、誰為此禍。"},{"id":"pbf49af2d0238-1","text":"胡逝我梁、不入唁我。"},{"id":"p1f8067c4305c-1","text":"始者不如今、云不我可。"},{"id":"p88397e69ecc3-1","text":"彼何人斯、胡逝我陳。"},{"id":"p29dc3dbf7aea-1","text":"我聞其聲、不見其身。"},{"id":"p0066f9711bfe-1","text":"不愧于人、不畏于天。"},{"id":"p3e330948dc7d-1","text":"彼何人斯、其為飄風。"},{"id":"p12b6178561ab-1","text":"胡不自北、胡不自南。"},{"id":"p3e5ed6a0ac19-1","text":"胡逝我梁、祇攪我心。"},{"id":"pf109e6512943-1","text":"爾之安行、亦不遑舍。"},{"id":"p1bfbc56223cb-1","text":"爾之亟行、遑脂爾車。"},{"id":"p9eda5dfa3856-1","text":"壹者之來、云何其盱。"},{"id":"pc611afc895a9-1","text":"爾還而入、我心易也。"},{"id":"p1366d0433a95-1","text":"還而不入、否難知也。"},{"id":"p004e97eb4af8-1","text":"壹者之來、俾我祇也。"},{"id":"p98e5b19355c5-1","text":"伯氏吹壎、仲氏吹篪。"},{"id":"p87223356d307-1","text":"及爾如貫、諒不我知。"},{"id":"p8bf5bebad0b8-1","text":"出此三物、以詛爾斯。"},{"id":"pfd8ced1f5a3d-1","text":"為鬼為蜮、則不可得。"},{"id":"pf6395760fb6e-1","text":"有靦面目、視人罔極。"},{"id":"p90d120b9a6ff-1","text":"作此好歌、以極反側。"},{"id":"p1d07fd53bd3b-1","text":"200.  巷伯"},{"id":"p2613cd8a2ae4-1","text":"萋兮斐兮、成是貝錦。"},{"id":"pc653b639f8f6-1","text":"彼譖人者、亦已大甚。"},{"id":"pc6425d763c46-1","text":"哆兮侈兮、成是南箕。"},{"id":"pfffb50707f4f-1","text":"彼譖人者、誰適與謀。"},{"id":"p1fe0bf5eeaff-1","text":"緝緝翩翩、謀欲譖人。"},{"id":"p0319a2cd9527-1","text":"慎爾言也、謂爾不信。"},{"id":"pe47fb74e6521-1","text":"捷捷幡幡、謀欲譖言。"},{"id":"p125eeb391635-1","text":"豈不爾受、既其女遷。"},{"id":"p691b7f17f158-1","text":"驕人好好、勞人草草。"},{"id":"pcb1cb9f1a860-1","text":"蒼天蒼天、視彼驕人、矜此勞人。"},{"id":"pfffb50707f4f-2","text":"彼譖人者、誰適與謀。"},{"id":"p809655af4fcf-1","text":"取彼譖人、投畀豺虎。"},{"id":"pd108be66b402-1","text":"豺虎不食、投畀有北。"},{"id":"p9d9edd952873-1","text":"有北不受、投畀有昊。"},{"id":"p12670b74ec33-1","text":"楊園之道、猗于畝丘。"},{"id":"p720e28c163b7-1","text":"寺人孟子、作為此詩。"},{"id":"pf226e3e2e76b-1","text":"凡百君子、敬而聽之。"},{"id":"p7e4d0ad0890f-1","text":"201.  谷風"},{"id":"p22ca257202a0-1","text":"習習谷風、維風及雨。"},{"id":"p1c515ee98ce3-1","text":"將恐將懼、維予與女。"},{"id":"p126f4c416689-1","text":"將安將樂、女轉棄予。"},{"id":"p0d55c2d0b91c-1","text":"習習谷風、維風及頹。"},{"id":"p4808130aae41-1","text":"將恐將懼、寘予于懷。"},{"id":"ped312b9242a8-1","text":"將安將樂、棄予如遺。"},{"id":"p34c0500f08bd-1","text":"習習谷風、維山崔嵬。"},{"id":"p87e230beed45-1","text":"無草不死、無木不萎。"},{"id":"p7802269f329d-1","text":"忘我大德、思我小怨。"},{"id":"pf4aa5a6705ba-1","text":"202.  蓼莪"},{"id":"p09b3c5c586b0-1","text":"蓼蓼者莪、匪莪伊蒿。"},{"id":"p5df165943dc3-1","text":"哀哀父母、生我劬勞。"},{"id":"pd194bf92e9f8-1","text":"蓼蓼者莪、匪莪伊蔚。"},{"id":"p87fcf57ab28a-1","text":"哀哀父母、生我勞瘁。"},{"id":"pb1f528ab49a9-1","text":"缾之罊矣、維罍之恥。"},{"id":"pdefff4ae30d1-1","text":"鮮民之生、不如死之久矣。"},{"id":"p8ee64123bb45-1","text":"無父何怙、無母何恃。"},{"id":"pb3a9ba2e9712-1","text":"出則銜恤、入則靡至。"},{"id":"p449dc977a383-1","text":"父兮生我、母兮鞠我。"},{"id":"pffc88bc99cbd-1","text":"拊我畜我、長我育我。"},{"id":"p22b1358df80f-1","text":"顧我復我、出入腹我。"},{"id":"pc1b199632565-1","text":"欲報之德、昊天罔極。"},{"id":"pbb86d37bfff3-1","text":"南山烈烈、飄風發發。"},{"id":"p2dd1d3eead1c-1","text":"民莫不穀、我獨何害。"},{"id":"p98761d9fa8ed-1","text":"南山律律、飄風弗弗。"},{"id":"p40b77d0e6c40-1","text":"民莫不穀、我獨不卒。"},{"id":"p482cafe0b058-1","text":"203.  大東"},{"id":"p956267064773-1","text":"有饛簋飧、有捄棘匕。"},{"id":"p7094d446a36f-1","text":"周道如砥、其直如矢。"},{"id":"pe6aa0bfadc57-1","text":"君子所履、小人所視。"},{"id":"p26552f8baa03-1","text":"睠言顧之、潸焉出涕。"},{"id":"pd5fef0b2c220-1","text":"小東大東、杼柚其空。"},{"id":"p0747000cacd5-1","text":"糾糾葛屨、可以履霜。"},{"id":"pebe689c91243-1","text":"佻佻公子、行彼周行。"},{"id":"p655180976ce4-1","text":"既往既來、使我心疚。"},{"id":"pd75928ea0363-1","text":"有冽氿泉、 無浸穫薪。"},{"id":"p2cc0b69f8789-1","text":"契契寤歎、哀我憚人。"},{"id":"pb0c2a0efa7c6-1","text":"薪是穫薪、尚可載也。"},{"id":"pd45b286aaabf-1","text":"哀我憚人、亦可息也。"},{"id":"p31e47af4b6d9-1","text":"東人之子、職勞不來。"},{"id":"p1f4d31b2ff27-1","text":"西人之子、粲粲衣服。"},{"id":"p50dcbdfc5798-1","text":"舟人之子、熊羆是裘。"},{"id":"p64a8c6a0ae0c-1","text":"私人之子、百僚是試。"},{"id":"pbb1c7312c98e-1","text":"或以其酒、不以其漿。"},{"id":"p520a94400ef9-1","text":"鞙鞙佩璲、不以其長。"},{"id":"p5ee25124865f-1","text":"維天有漢、監亦有光。"},{"id":"p976bc601f2cc-1","text":"跂彼織女、終日七襄。"},{"id":"pe42d6b49fc14-1","text":"雖則七襄、不成報章。"},{"id":"p805ecf11c3a0-1","text":"睆彼牽牛、不以服箱。"},{"id":"p6f321b4a9ed5-1","text":"東有啟明、西有長庚。"},{"id":"p2d9662d94eec-1","text":"有捄天畢、載施之行。"},{"id":"p64495c812fde-1","text":"維南有箕、不可以簸揚。"},{"id":"pe672c4643657-1","text":"維北有斗、不可以挹酒漿。"},{"id":"p1dbf301b27df-1","text":"維南有箕、載翕其舌。"},{"id":"p6cf767004300-1","text":"維北有斗、西柄之揭。"},{"id":"pfd37128718df-1","text":"204.  四月"},{"id":"pf65f096a6b76-1","text":"四月維夏、六月徂暑。"},{"id":"pebbc2f8ee758-1","text":"先祖匪人、胡寧忍予。"},{"id":"pe09ee69fde86-1","text":"秋日淒淒、百卉具腓。"},{"id":"p5ff3820bd394-1","text":"亂離瘼矣、爰其適歸。"},{"id":"p1dc27a0f1871-1","text":"冬日烈烈、飄風發發。"},{"id":"p2dd1d3eead1c-2","text":"民莫不穀、我獨何害。"},{"id":"p4d028d3528ec-1","text":"山有嘉卉、侯栗侯梅。"},{"id":"p0a02fbdcce78-1","text":"廢為殘賊、莫知其尤。"},{"id":"p6c8578ade485-1","text":"相彼泉水、載清載濁。"},{"id":"pa90cebce4b1b-1","text":"我曰構禍、曷云能穀。"},{"id":"pb2f353c1a8c4-1","text":"滔滔江漢、南國之紀。"},{"id":"pe6e12dfbf027-1","text":"盡瘁以仕、寧莫我有。"},{"id":"pf8f858ce1343-1","text":"匪鷻匪鳶、翰飛戾天。"},{"id":"p76d5fb218f7f-1","text":"匪鱣匪鮪、潛逃于淵。"},{"id":"p6a921434a043-1","text":"山有蕨薇、隰有杞桋。"},{"id":"p8df093e6d60f-1","text":"君子作歌、維以告哀。"},{"id":"pbf2293ce83e9-1","text":"北山之什"},{"id":"p557df19ca756-1","text":"205.  北山"},{"id":"p10c600245298-1","text":"涉彼北山、言采其杞。"},{"id":"p380d783b9266-1","text":"偕偕士子、朝夕從事。"},{"id":"pb990986882c8-2","text":"王事靡盬、憂我父母。"},{"id":"p7792a80c185e-1","text":"溥天之下、莫非王土。"},{"id":"pd73ebbda932b-1","text":"率土之濱、莫非王臣。"},{"id":"p328704e51513-1","text":"大夫不均、我從事獨賢。"},{"id":"pc22a5de82478-1","text":"四牡彭彭、王事傍傍。"},{"id":"ped376b5dec94-1","text":"嘉我未老、鮮我方將。"},{"id":"p27d36b63f62c-1","text":"旅力方剛、經營四方。"},{"id":"p62383a705e73-1","text":"或燕燕居息、或盡瘁事國。"},{"id":"pf87befb5872c-1","text":"或息偃在床、或不已于行。"},{"id":"pda8167c0b7d6-1","text":"或不知叫號、或慘慘劬勞。"},{"id":"p0f6a0ccac9f9-1","text":"或棲遲偃仰、或王事鞅掌。"},{"id":"p7739c8cefef9-1","text":"或湛樂飲酒、或慘慘畏咎。"},{"id":"pb3020ece5cec-1","text":"或出入風議、或靡事不為。"},{"id":"p0698734fb0ac-1","text":"206.  無將大車"},{"id":"p9bff9c29beaa-1","text":"無將大車、祇自塵兮。"},{"id":"pc80c280c8069-1","text":"無思百憂、祇自疧兮。"},{"id":"pfcf6f0bbde4e-1","text":"無將大車、維塵冥冥。"},{"id":"p50df24521ec7-1","text":"無思百憂、不出于熲。"},{"id":"pa13106f577cd-1","text":"無將大車、維塵雝兮。"},{"id":"p593b2022cf0f-1","text":"無思百憂、祇自重兮。"},{"id":"p1e756155a90e-1","text":"207.  小明"},{"id":"p742df3666baf-1","text":"明明上天、照臨下土。"},{"id":"pd2351141cd73-1","text":"我征徂西、至于艽野。"},{"id":"pf3c365b0df73-1","text":"二月初吉、載離寒暑。"},{"id":"p7124dd711e30-1","text":"心之憂矣、其毒大苦。"},{"id":"pe2b6c2ba68f8-1","text":"念彼共人、涕零如雨。"},{"id":"pd6db92488f54-1","text":"豈不懷歸、畏此罪罟。"},{"id":"pf4a5f4c46a8c-1","text":"昔我往矣、日月方除。"},{"id":"p7889eba625a4-1","text":"曷云其還、歲聿云莫。"},{"id":"p85edace41264-1","text":"念我獨兮、我事孔庶。"},{"id":"p9acab1c2c359-1","text":"心之憂矣、憚我不暇。"},{"id":"pbc937defca18-1","text":"念彼共人、睠睠懷顧。"},{"id":"p256d92645e06-1","text":"豈不懷歸、畏此譴怒。"},{"id":"p91b703877c3b-1","text":"昔我往矣、日月方奧。"},{"id":"p7178f2362a81-1","text":"曷云其還、政事愈蹙。"},{"id":"p9cdfe8d44760-1","text":"歲聿云莫、采蕭穫菽。"},{"id":"p0e69e2fe71f7-1","text":"心之憂矣、自始伊戚。"},{"id":"p348ee0d2ed36-1","text":"念彼共人、興言出宿。"},{"id":"p957ce07e2b78-1","text":"豈不懷歸、畏此反覆。"},{"id":"p763a748b8665-1","text":"嗟爾君子、無恆安處。"},{"id":"p4df53c4dc865-1","text":"靖共爾位、正直是興。"},{"id":"pfab5bc99df74-1","text":"神之聽之、式穀以女。"},{"id":"p0f7210efbdb8-1","text":"嗟爾君子、無恆安息。"},{"id":"p9f51639c9850-1","text":"靖共爾位、好是正直。"},{"id":"pef91ff1124f5-1","text":"神之聽之、介爾景福。"},{"id":"pcbdbe26e72d0-1","text":"208.  鼓鍾"},{"id":"p76f20b14ade5-1","text":"鼓鍾將將、淮水湯湯。"},{"id":"pc73f936a418d-1","text":"憂心且傷。"},{"id":"p90e95c3f1116-1","text":"淑人君子、懷允不忘。"},{"id":"pff5474200d70-1","text":"鼓鍾喈喈、淮水湝湝。"},{"id":"p57e73aacac1e-1","text":"憂心且悲。"},{"id":"pae58eeceeba1-1","text":"淑人君子、其德不回。"},{"id":"p39f856881dcb-1","text":"鼓鍾伐鼛、淮有三洲。"},{"id":"p9d216ba2f9b8-1","text":"憂心且妯。"},{"id":"p5c9a35967aa1-1","text":"淑人君子、其德不猶。"},{"id":"p3f99dafc97a3-1","text":"鼓鍾欽欽、鼓瑟鼓琴。"},{"id":"pe6b18e93462a-1","text":"笙磬同音。"},{"id":"p1a272acfd550-1","text":"以雅以南、以籥不偕。"},{"id":"pd6662df94249-1","text":"209.  楚茨"},{"id":"pcd51a33ef567-1","text":"楚楚者茨、言抽其棘。"},{"id":"p983303b6f4c2-1","text":"自昔何為、我蓺黍稷。"},{"id":"pde2771e1547b-1","text":"我黍與與、我稷翼翼。"},{"id":"p7e11deff78be-1","text":"我倉既盈、我庾維憶。"},{"id":"p6a59750d279d-1","text":"以為酒食、以饗以祀。"},{"id":"p864a2eb35bc4-1","text":"以妥以侑、以介景福。"},{"id":"p0922bb4f3034-1","text":"濟濟蹌蹌、絜爾牛羊、以往烝嘗。"},{"id":"p417ded24808b-1","text":"或剝或亨、或肆或將。"},{"id":"p516a4898bca7-1","text":"祝祭于祊、祀事孔明。"},{"id":"p4e725f12f5c2-1","text":"先祖是皇、神保是饗。"},{"id":"p25700e5106e3-1","text":"孝孫有慶。"},{"id":"pf7988c55a5e3-1","text":"報以介福、萬壽無疆。"},{"id":"p25ee9e18d8cb-1","text":"執爨踖踖、為俎孔碩、或燔或炙。"},{"id":"p8852737ebcdf-1","text":"君婦莫莫、為豆孔庶。"},{"id":"pa40ff7d5007d-1","text":"為賓為客、獻酬交錯。"},{"id":"pee1914eeb44b-1","text":"禮儀卒度、笑語卒獲。"},{"id":"pd50d012feb02-1","text":"神保是格。"},{"id":"p0e33d01dfc2a-1","text":"報以介福、萬壽攸酢。"},{"id":"pdf309f2dc832-1","text":"我孔熯矣、式禮莫愆。"},{"id":"pbd73e99a5a0f-1","text":"工祝致告、徂賚孝孫。"},{"id":"pd3ee64a54155-1","text":"苾芬孝祀、神嗜飲食。"},{"id":"p3fffe999e9e5-1","text":"卜爾百福、如幾如式。"},{"id":"pc70c45ab30b2-1","text":"既齊既稷、既匡既敕。"},{"id":"pd4351fa0aafb-1","text":"永錫爾極、時萬時憶。"},{"id":"pa0437394ee74-1","text":"禮儀既備、鍾鼓既戒。"},{"id":"pdfaafac223ba-1","text":"孝孫徂位、工祝致告。"},{"id":"pad39a489c044-1","text":"神具醉止、皇尸載起。"},{"id":"p50bb8da28778-1","text":"鼓鍾送尸、神保聿歸。"},{"id":"p24e87b6e7324-1","text":"諸宰君婦、廢徹不遲。"},{"id":"p7127e56e07fb-1","text":"諸父兄弟、備言燕私。"},{"id":"pc137e0ab7008-1","text":"樂具入奏、以綏後祿。"},{"id":"pd7f79f06b9aa-1","text":"爾殽既將、莫怨具慶。"},{"id":"p0da58a727fbd-1","text":"既醉既飽、小大稽首。"},{"id":"pb0c5b49d87c3-1","text":"神嗜飲食、使君壽考。"},{"id":"pf8ab92e83f15-1","text":"孔惠孔時、維其盡之。"},{"id":"peb3cca91923f-1","text":"子子孫孫、勿替引之。"},{"id":"p34d186e599c4-1","text":"210.  信南山"},{"id":"p4d653d380341-1","text":"信彼南山、維禹甸之。"},{"id":"pb6694b129690-1","text":"畇畇原隰、曾孫田之。"},{"id":"pc093dbbb4ef6-1","text":"我疆我理、南東其畝。"},{"id":"p1ec27c020b8b-1","text":"上天同雲、雨雪雰雰。"},{"id":"p2ec92f22b3c4-1","text":"益之以霢霂、既優既渥、既霑既足、生我百穀。"},{"id":"pc77d3f67578d-1","text":"疆場翼翼、黍稷彧彧。"},{"id":"pe117fe29021b-1","text":"曾孫之穡、以為酒食。"},{"id":"p038f366d0ede-1","text":"畀我尸賓、壽考萬年。"},{"id":"p425c436f3920-1","text":"中田有廬、疆場有瓜。"},{"id":"pe000cd07f323-1","text":"是剝是菹、獻之皇祖。"},{"id":"pf8cbfa516fd0-1","text":"曾孫壽考、受天之祜。"},{"id":"pec0730d7ee97-1","text":"祭以清酒、從以騂牡、享于祖考。"},{"id":"pe5dd9b187a96-1","text":"執其鸞刀、以啟其毛、取其血膋。"},{"id":"p7005f0a24923-1","text":"是烝是享、苾苾芬芬、祀事孔明。"},{"id":"p72bed89ac2b6-1","text":"先祖是皇。"},{"id":"pf7988c55a5e3-2","text":"報以介福、萬壽無疆。"},{"id":"pfea0090559e0-1","text":"211.  甫田"},{"id":"pea6aa5630791-1","text":"倬彼甫田、歲取十千。"},{"id":"p82fdcfcc0386-1","text":"我取其陳、食我農人。"},{"id":"p2905d1029cb2-1","text":"自古有年。"},{"id":"p237a1c506c39-1","text":"今適南畝、或耘或耔、黍稷薿薿。"},{"id":"p1e8922059549-1","text":"攸介攸止、烝我髦士。"},{"id":"p189c91a5fd14-1","text":"以我齊明、與我犧羊、以社以方。"},{"id":"p553cf1954c15-1","text":"我田既臧、農夫之慶。"},{"id":"p7aefc8c987b1-1","text":"琴瑟擊鼓、以御田祖。"},{"id":"p7a7cf3a75c60-1","text":"以祈甘雨、以介我稷黍、以穀我士女。"},{"id":"p85513b40b524-1","text":"曾孫來止、以其婦子、饁彼南畝、田畯至喜。"},{"id":"paf1a87e05d77-1","text":"攘其左右、嘗其旨否。"},{"id":"pb88c58384354-1","text":"禾易長畝、終善且有。"},{"id":"p6edb6cea5162-1","text":"曾孫不怒、農夫克敏。"},{"id":"p541374f8f140-1","text":"曾孫之稼、如茨如梁。"},{"id":"pe5ef58b9df5d-1","text":"曾孫之庾、如坻如京。"}]}