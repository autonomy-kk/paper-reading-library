{"bookId":"cp-3","editionId":"93bcda1053b3f13c","chapterId":"c0013","paragraphs":[{"id":"p08d28477e221-1","text":"曰："},{"id":"p8af325de69f8-1","text":"遂古之初，谁传道之？"},{"id":"pb222ca90bda5-1","text":"上下未形，何由考之？"},{"id":"pf0e43d0ae89a-1","text":"冥昭瞢暗，谁能极之？"},{"id":"p7834104e745f-1","text":"冯翼惟象，何以识之？"},{"id":"p0778a1a8997f-1","text":"明明暗暗，惟时何为？"},{"id":"p7ea57253dca0-1","text":"阴阳三合，何本何化？"},{"id":"p9c220bd00809-1","text":"圜则九重，孰营度之？"},{"id":"p7ff82fe99347-1","text":"惟兹何功，孰初作之？"},{"id":"pfa09d280cc1d-1","text":"斡维焉系，天极焉加？"},{"id":"pc99e32f976ed-1","text":"八柱何当，东南何亏？"},{"id":"p297d8806fba7-1","text":"九天之际，安放安属？"},{"id":"p965caefa747d-1","text":"隅隈多有，谁知其数？"},{"id":"pc0e3233a9e6f-1","text":"天何所沓？"},{"id":"pc850b7449732-1","text":"十二焉分？"},{"id":"p8db1e44e45a4-1","text":"日月安属？"},{"id":"pd4adaad35694-1","text":"列星安陈？"},{"id":"p2b8a7c487388-1","text":"出自汤谷，次于蒙汜。"},{"id":"p7cf30780a18f-1","text":"自明及晦，所行几里？"},{"id":"p856520be3537-1","text":"夜光何德，死则又育？"},{"id":"pc5004a87e8bf-1","text":"厥利维何，而顾菟在腹？"},{"id":"pd864a8ff9832-1","text":"女岐无合，夫焉取九子？"},{"id":"p9df23cd61fd5-1","text":"伯强何处？"},{"id":"p9620d2dc50f2-1","text":"惠气安在？"},{"id":"p8a91e05fbb85-1","text":"何阖而晦？"},{"id":"pf37e6d186566-1","text":"何开而明？"},{"id":"pf8c1301d06c4-1","text":"角宿未旦，曜灵安藏？"},{"id":"p1d30a50b2907-1","text":"不任汩鸿，师何以尚之？"},{"id":"p52f2447d8a54-1","text":"佥曰"},{"id":"pf1bbfa40ca7e-1","text":"“何忧，何不课而行之？”"},{"id":"pdf4ae6bef755-1","text":"鸱龟曳衔，鲧何听焉？"},{"id":"p20ce80400a83-1","text":"顺欲成功，帝何刑焉？"},{"id":"p438f1d880070-1","text":"永遏在羽山，夫何三年不施？"},{"id":"p03609c511d1a-1","text":"伯禹愎鲧，夫何以变化？"},{"id":"p27f8da837f8f-1","text":"纂就前绪，遂成考功。"},{"id":"p1706f9437f07-1","text":"何续初继业，而厥谋不同？"},{"id":"p474d898e2d48-1","text":"洪泉极深，何以窴之？"},{"id":"p1889cda4c03c-1","text":"地方九则，何以坟之？"},{"id":"p81465625a8bd-1","text":"河海应龙？"},{"id":"peb89225f932b-1","text":"何尽何历？"},{"id":"pf04f12e1aec1-1","text":"鲧何所营？"},{"id":"pa065d07d4bb1-1","text":"禹何所成？"},{"id":"pebe121293878-1","text":"康回冯怒，墬何故以东南倾？"},{"id":"p1598b09d7cf3-1","text":"九州安错？"},{"id":"pd43d1e893321-1","text":"川谷何洿？"},{"id":"p578c2bcfe058-1","text":"东流不溢，孰知其故？"},{"id":"pbed60118517c-1","text":"东西南北，其修孰多？"},{"id":"p16d5dea39247-1","text":"南北顺椭，其衍几何？"},{"id":"p0700fed3e9bb-1","text":"昆仑悬圃，其尻安在？"},{"id":"pb5a54e03fbd1-1","text":"增城九重，其高几里？"},{"id":"p3b0a1ace9f4f-1","text":"四方之门，其谁从焉？"},{"id":"pe2d1223c564a-1","text":"西北辟启，何气通焉？"},{"id":"p76105abe7f57-1","text":"日安不到？"},{"id":"p1120318e19ed-1","text":"烛龙何照？"},{"id":"pe01e80282919-1","text":"羲和之未扬，若华何光？"},{"id":"pb52f2ac0edf8-1","text":"何所冬暖？"},{"id":"p698b1fb5a21e-1","text":"何所夏寒？"},{"id":"pc1e44b45f404-1","text":"焉有石林？"},{"id":"pa455d1c993e2-1","text":"何兽能言？"},{"id":"pcfdba9303502-1","text":"焉有虬龙，负熊以游？"},{"id":"pcdb80db8ba3d-1","text":"雄虺九首，鯈忽焉在？"},{"id":"p4413e9db34c2-1","text":"何所不死？"},{"id":"pae457dddf0fa-1","text":"长人何守？"},{"id":"p3fb238459cad-1","text":"靡蓱九衢，枲华安居？"},{"id":"p3da03512861a-1","text":"灵蛇吞象，厥大何如？"},{"id":"pdf922ac3c787-1","text":"黑水玄趾，三危安在？"},{"id":"pac61047f7eaa-1","text":"延年不死，寿何所止？"},{"id":"pa39a6a6060e4-1","text":"鲮鱼何所？"},{"id":"pe7e3ed2d8215-1","text":"鬿堆焉处？"},{"id":"p0aef55e5031f-1","text":"羿焉彃日？"},{"id":"pbb7c9cf3db49-1","text":"乌焉解羽？"},{"id":"p898f0fa8d934-1","text":"禹之力献功，降省下土四方。"},{"id":"pdc96c44d1b92-1","text":"焉得彼嵞山女，而通之於台桑？"},{"id":"pfeaddb539ac5-1","text":"闵妃匹合，厥身是继。"},{"id":"p0e46646d3ba9-1","text":"胡维嗜不同味，而快鼌饱？"},{"id":"pa48c94072675-1","text":"启代益作后，卒然离蠥。"},{"id":"p0936df1ebc16-1","text":"何启惟忧，而能拘是达？"},{"id":"pd7f73fe66fe2-1","text":"皆归射鞫，而无害厥躬。"},{"id":"p237f979b4a93-1","text":"何后益作革，而禹播降？"},{"id":"pc5f404d194b5-1","text":"启棘宾商，《九辨》《九歌》。"},{"id":"p029054e1df89-1","text":"何勤子屠母，而死分竟地？"},{"id":"pb33e5ea3f37f-1","text":"帝降夷羿，革孽夏民。"},{"id":"p5694bb52324d-1","text":"胡射夫河伯，而妻彼雒嫔？"},{"id":"pec93cc947af3-1","text":"冯珧利决，封豨是射。"},{"id":"pa801eb73dfd3-1","text":"何献蒸肉之膏，而后帝不若？"},{"id":"pc08bdfb3382f-1","text":"浞娶纯狐，眩妻爰谋。"},{"id":"p5296c00abc95-1","text":"何羿之射革，而交吞揆之？"},{"id":"p7febac640d01-1","text":"阻穷西征，岩何越焉？"},{"id":"p6c451f821ae7-1","text":"化而为黄熊，巫何活焉？"},{"id":"pda431c778040-1","text":"咸播秬黍，莆雚是营。"},{"id":"pa5bdb7246737-1","text":"何由并投，而鲧疾修盈？"},{"id":"pc086c7e6b104-1","text":"白蜺婴茀，胡为此堂？"},{"id":"p2dd7ff9c939e-1","text":"安得夫良药，不能固臧？"},{"id":"p1c2e966be043-1","text":"天式从横，阳离爰死。"},{"id":"pd4789f6b8755-1","text":"大鸟何鸣，夫焉丧厥体？"},{"id":"pdd9d02fcb3c1-1","text":"蓱号起雨，何以兴之？"},{"id":"p975a030c3d80-1","text":"撰体协胁，鹿何膺之？"},{"id":"p89cc982b3a0b-1","text":"鳌戴山抃，何以安之？"},{"id":"p5dad16cbc8db-1","text":"释舟陵行，何之迁之？"},{"id":"p1b95fc071c41-1","text":"惟浇在户，何求于嫂？"},{"id":"p3377e204d8b7-1","text":"何少康逐犬，而颠陨厥首？"},{"id":"pa46c178eef04-1","text":"女歧缝裳，而馆同爰止。"},{"id":"pf7e2827995c3-1","text":"何颠易厥首，而亲以逢殆？"},{"id":"pde2498744285-1","text":"汤谋易旅，何以厚之？"},{"id":"p90715750010c-1","text":"覆舟斟寻，何道取之？"},{"id":"p2f6f90da41b9-1","text":"桀伐蒙山，何所得焉？"},{"id":"p92909444f5d4-1","text":"妺嬉何肆，汤何殛焉？"},{"id":"pb3b20bd9fa53-1","text":"舜闵在家，父何以鳏？"},{"id":"p0e6e980fbee6-1","text":"尧不姚告，二女何亲？"},{"id":"p854de5a0f511-1","text":"厥萌在初，何所亿焉？"},{"id":"p12c4a74cbd87-1","text":"璜台十成，谁所极焉？"},{"id":"pb7b4f308a7e1-1","text":"登立为帝，孰道尚之？"},{"id":"pd9920972fe3a-1","text":"女娲有体，孰制匠之？"},{"id":"p7c4830decf38-1","text":"舜服厥弟，终然为害。"},{"id":"p17ea64528dfe-1","text":"何肆犬豕，而厥身不危败？"},{"id":"p1a7eef2f923e-1","text":"吴获迄古，南岳是止。"},{"id":"pb1235cfa47ec-1","text":"孰期去斯，得两男子？"},{"id":"p65201be15dd6-1","text":"缘鹄饰玉，后帝是飨。"},{"id":"p35dc6dc0f8cd-1","text":"何承谋夏桀，终以灭丧？"},{"id":"pfd0769a62007-1","text":"帝乃降观，下逢伊挚。"},{"id":"p2017a4700722-1","text":"何条放致罚，而黎服大说？"},{"id":"p91ece18ec44e-1","text":"简狄在台，喾何宜？"},{"id":"p65755ec94989-1","text":"玄鸟致贻，女何喜？"},{"id":"pf8e25458d8ad-1","text":"该秉季德，厥父是臧。"},{"id":"p99e2667b1fb0-1","text":"胡终弊于有扈，牧夫牛羊？"},{"id":"p7190563b252e-1","text":"干协时舞，何以怀之？"},{"id":"p07fc4a204cde-1","text":"平胁曼肤，何以肥之？"},{"id":"pb5d41209849b-1","text":"有扈牧竖，云何而逢？"},{"id":"p0ca6cf24dfd3-1","text":"击床先出，其命何从？"},{"id":"pbf536214b72d-1","text":"恒秉季德，焉得夫朴牛？"},{"id":"p32c5d56a9f96-1","text":"何往营班禄，不但还来？"},{"id":"p7266a345ae72-1","text":"昏微循迹，有狄不宁。"},{"id":"p00f1792c2111-1","text":"何繁鸟萃棘，负子肆情？"},{"id":"p1a0750d324ed-1","text":"眩弟并淫，危害厥兄。"},{"id":"pc9daf8a7025a-1","text":"何变化以作诈，而后嗣逢长？"},{"id":"pceac41aa8be0-1","text":"成汤东巡，有莘爰极。"},{"id":"pf23222f66a43-1","text":"何乞彼小臣，而吉妃是得？"},{"id":"p5e8cb5f90a11-1","text":"水滨之木，得彼小子。"},{"id":"p6094778c09d7-1","text":"夫何恶之，媵有莘之妇？"},{"id":"pb2a3d69f1150-1","text":"汤出重泉，夫何辠尤？"},{"id":"p7551ddfd81b2-1","text":"不胜心伐帝，夫谁使挑之？"},{"id":"pcdfbe91c6459-1","text":"会朝争盟，何践吾期？"},{"id":"p44363f0675d8-1","text":"苍鸟群飞，孰使萃之？"},{"id":"p0c2cda7fb215-1","text":"列击纣躬，叔旦不嘉。"},{"id":"p6be32d92ac3d-1","text":"何亲揆发足，周之命以咨嗟？"},{"id":"p3c672f3da964-1","text":"授殷天下，其位安施？"},{"id":"p2070d8fbb316-1","text":"反成乃亡，其罪伊何？"},{"id":"p63638568f541-1","text":"争遣伐器，何以行之？"},{"id":"p740740dfff8a-1","text":"并驱击翼，何以将之？"},{"id":"pb12c10055950-1","text":"昭后成游，南土爰底。"},{"id":"pcc0f86d1ffb8-1","text":"厥利惟何，逢彼白雉？"},{"id":"p1cc03920f51b-1","text":"穆王巧梅，夫何为周流？"},{"id":"pc993d4fa1a52-1","text":"环理天下，夫何索求？"},{"id":"pbd8713447b4b-1","text":"妖夫曳炫，何号于市？"},{"id":"pa3defa794984-1","text":"周幽谁诛？"},{"id":"p49b7e55e5761-1","text":"焉得夫褒姒？"},{"id":"p20811989f18d-1","text":"天命反侧，何罚何佑？"},{"id":"p6f003bcfa9f7-1","text":"齐桓九会，卒然身杀。"},{"id":"p5db3f45098c3-1","text":"彼王纣之躬，孰使乱惑？"},{"id":"pa35d48667b0f-1","text":"何恶辅弼，谗谄是服？"},{"id":"pf3a344c6daf5-1","text":"比干何逆，而抑沈之？"},{"id":"p4aebdaee84df-1","text":"雷开阿顺，而赐封之？"},{"id":"p14d65fdbe52a-1","text":"何圣人之一德，卒其异方？"},{"id":"p40b5621ffa4c-1","text":"梅伯受醢，箕子详狂？"},{"id":"p90f990e41f78-1","text":"稷维元子，帝何竺之？"},{"id":"pfd85c316a6fd-1","text":"投之于冰上，鸟何燠之？"},{"id":"p28867ec1152f-1","text":"何冯弓挟矢，殊能将之？"},{"id":"p4a02faf81f8f-1","text":"既惊帝切激，何逢长之？"},{"id":"p50d9800dfc92-1","text":"伯昌号衰，秉鞭作牧。"},{"id":"p6ad62cf8dc33-1","text":"何令彻彼岐社，命有殷国？"},{"id":"pe039467b868a-1","text":"迁藏就岐，何能依？"},{"id":"p149c46f8aca8-1","text":"殷有惑妇，何所讥？"},{"id":"p04b66bb5d241-1","text":"受赐兹醢，西伯上告。"},{"id":"pc34572fd40f9-1","text":"何亲就上帝罚，殷之命以不救？"},{"id":"p39f1ed2e26d1-1","text":"师望在肆，昌何识？"},{"id":"p709e1076f501-1","text":"鼓刀扬声，后何喜？"},{"id":"p620973408ed4-1","text":"武发杀殷，何所悒？"},{"id":"paa4c42859e42-1","text":"载尸集战，何所急？"},{"id":"pd69985ea9107-1","text":"伯林雉经，维其何故？"},{"id":"p52a353036285-1","text":"何感天抑墬，夫谁畏惧？"},{"id":"p3bccaaf80753-1","text":"皇天集命，惟何戒之？"},{"id":"pded1eff85f57-1","text":"受礼天下，又使至代之？"},{"id":"p83c4aa02884f-1","text":"初汤臣挚，后兹承辅。"},{"id":"pff4e8de5b186-1","text":"何卒官汤，尊食宗绪？"},{"id":"pd16e2f902934-1","text":"勋阖梦生，少离散亡。"},{"id":"pb9b995c5b150-1","text":"何壮武历，能流厥严？"},{"id":"p34dc60a2ba12-1","text":"彭铿斟雉，帝何飨？"},{"id":"p34ae881948dd-1","text":"受寿永多，夫何久长？"},{"id":"p1fc01c91b64f-1","text":"中央共牧，后何怒？"},{"id":"pc2d882a46546-1","text":"蜂蛾微命，力何固？"},{"id":"p638af6dfd610-1","text":"惊女采薇，鹿何佑？"},{"id":"p40fd03b691f6-1","text":"北至回水，萃何喜？"},{"id":"p77536b4eed30-1","text":"兄有噬犬，弟何欲？"},{"id":"pa1d9018f077a-1","text":"易之以百两，卒无禄？"},{"id":"p0b38ea55545f-1","text":"薄暮雷电，归何忧？"},{"id":"p8165964fd5e4-1","text":"厥严不奉，帝何求？"},{"id":"p752160dfce8e-1","text":"伏匿穴处，爰何云？"},{"id":"pff3b6b39a78f-1","text":"荆勋作师，夫何长？"},{"id":"pf797695a2ea3-1","text":"悟过改更，我又何言？"},{"id":"p142963cdeaf8-1","text":"吴光争国，久余是胜。"},{"id":"pc4f58ce3326f-1","text":"何环穿自闾社丘陵，爰出子文？"},{"id":"pf7fa1a7460e4-1","text":"吾告堵敖以不长。"},{"id":"peaeaec408e48-1","text":"何试上自予，忠名弥彰？"}]}