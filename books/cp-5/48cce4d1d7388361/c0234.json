{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0234","paragraphs":[{"id":"p5a8c2a09e4c8-1","text":"地涌西山脉，名标禁御泉"},{"id":"p4ccef82828a4-1","text":"百层飞作雨，万顷汇成渊"},{"id":"p965156b6dff7-1","text":"润下终归海，源高却自天"},{"id":"pa80b2e73ff25-1","text":"萦烟来树杪，带雪落云边"},{"id":"p915046326da6-1","text":"隐见瑶光曳，琤苁佩响传"},{"id":"p77946f6c7f07-1","text":"红栋桥宛转，乌榜棹洄沿"},{"id":"pace9853bc1da-1","text":"蛟龙蟠翠岛，雁鹜起琼田"},{"id":"p1872540d1676-1","text":"镜面晶荧合，珠痕荡漾圆"},{"id":"p2c92a2f18ab7-1","text":"翠流初放荇，娇拥半开莲"},{"id":"p62a123da4b4e-1","text":"睿赏悬孤鉴，馀波溢九璇"},{"id":"pdeee8122d87a-1","text":"那居真有庆，鱼藻在诗篇"}]}