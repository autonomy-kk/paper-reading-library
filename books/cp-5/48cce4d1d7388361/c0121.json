{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0121","paragraphs":[{"id":"pa73bc62d8249-1","text":"蜃阙半模糊，踏浪惊呼"},{"id":"pb4bf538bfad4-1","text":"任将蠡测笑江湖"},{"id":"pe04c76f24074-1","text":"沐日光华还浴月，我欲乘桴"},{"id":"p4a3242e606c6-1","text":"钓得六鳌无"},{"id":"pbec548e30d94-1","text":"竿拂珊瑚"},{"id":"p00ef09a0e173-1","text":"桑田清浅问麻姑"},{"id":"pa10c9bbf2b3c-1","text":"水气浮天天接水，那是蓬壶"}]}