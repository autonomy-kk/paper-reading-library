{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0090","paragraphs":[{"id":"pced339bbb0e8-1","text":"谢家庭院残更立，燕宿雕梁"},{"id":"pc988f90d72fe-1","text":"月度银墙"},{"id":"p7ccb18650c22-1","text":"不辨花丛那辨香"},{"id":"pc4db42cb734c-1","text":"此情已自成追忆，零落鸳鸯"},{"id":"p6c650f36ab72-1","text":"雨歇微凉"},{"id":"p68e7340eab11-1","text":"十一年前梦一场"}]}