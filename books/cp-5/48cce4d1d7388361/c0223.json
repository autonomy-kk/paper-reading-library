{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0223","paragraphs":[{"id":"pbff883f04ea7-1","text":"高云媚春日，坐觉鱼鸟亲"},{"id":"p1442dbb5de36-1","text":"可怜暮春候，病中别故人"},{"id":"pcd7165938053-1","text":"莺啼花乱落，风吹成锦茵"},{"id":"pc1a16728eaa5-1","text":"君去一何速，到家垂柳新"},{"id":"p858731c66284-1","text":"芙蓉湖上月，照君垂长纶"}]}