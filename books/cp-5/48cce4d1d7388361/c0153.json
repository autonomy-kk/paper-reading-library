{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0153","paragraphs":[{"id":"p25df79ca2dd5-1","text":"知己一人谁是"},{"id":"p18fd80ac36bc-1","text":"已矣"},{"id":"p206c602c965b-1","text":"赢得误他生"},{"id":"p1b92f8faed1b-1","text":"有情终古似无情，别语悔分明"},{"id":"pd5181717db41-1","text":"莫道芳时易度，朝暮"},{"id":"p9224c902393f-1","text":"珍重好花天"},{"id":"p4fb7aab02f68-1","text":"为伊指点再来缘，疏雨洗遗钿"}]}