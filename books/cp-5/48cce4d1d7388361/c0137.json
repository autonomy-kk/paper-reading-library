{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0137","paragraphs":[{"id":"p219acc6b9672-1","text":"记绾长条欲别难"},{"id":"p4d3a425cfab6-1","text":"盈盈自此隔银湾"},{"id":"p3e5e433940e1-1","text":"便无风雪也摧残"},{"id":"p1514a1fce1b9-1","text":"青雀几时裁锦字，玉虫连夜翦春旙"},{"id":"pd1821b0bb37f-1","text":"不禁辛苦况相关"}]}