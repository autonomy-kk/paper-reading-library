{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0069","paragraphs":[{"id":"p62a3b9ec46b8-1","text":"才听夜雨，便觉秋如许"},{"id":"p4ea567e0d2ca-1","text":"绕砌蛩螀人不语，有梦转愁无据"},{"id":"p1678303c69c8-1","text":"乱山千叠横江，忆君游倦何方"},{"id":"p51abc29e973d-1","text":"知否小窗红烛"},{"id":"p8f921d2c1e36-1","text":"照人此夜凄凉"}]}