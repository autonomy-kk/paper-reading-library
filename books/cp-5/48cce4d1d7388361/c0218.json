{"bookId":"cp-5","editionId":"48cce4d1d7388361","chapterId":"c0218","paragraphs":[{"id":"pbe6e8dfc6884-1","text":"闲亭照白日，一室罗古今"},{"id":"p33c657c5d147-1","text":"偶焉此栖迟，抱膝悠然吟"},{"id":"p9d2ddce70a90-1","text":"吟罢有余适，散瞩复披襟"},{"id":"p5bbd063c57bf-1","text":"时开玉怀卷，或弹珠柱琴"},{"id":"p0c9f9ac487ce-1","text":"檐树吐新花，枝头语珍禽"},{"id":"p50b449cfb047-1","text":"花发饶冶色，禽鸣多姣音"},{"id":"p7c906b1343f0-1","text":"色冶眩春目，音姣伤春心"},{"id":"p6ea5e1c87259-1","text":"夕阳下虞渊，寂莫还空林"},{"id":"p8a1554f97c23-1","text":"清光复相照，片月西山岭"},{"id":"p48f21da9af6b-1","text":"东园桃李姿，是妾嫁君时"},{"id":"pea46359a87ff-1","text":"燕婉为夫妇，相爱不相离"},{"id":"pf141f5fba4c2-1","text":"良人忽远征，妾独守空帏"},{"id":"p519908b4d803-1","text":"忧来恒自叹，冀死魂追随"},{"id":"p3e59bc48d191-1","text":"又念妾死时，谁制万里衣"},{"id":"p1ff7f636bf60-1","text":"幸有双鲤鱼，拟为寄君辞"},{"id":"p61a13514dd37-1","text":"终日不成章，含泪自封题"},{"id":"pa71aa8621325-1","text":"君若得鲤鱼，剖鱼开素书"},{"id":"p9f31d62c24dd-1","text":"但看行中字，一一与泪俱"}]}