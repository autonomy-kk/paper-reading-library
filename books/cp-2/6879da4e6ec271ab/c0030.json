{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0030","paragraphs":[{"id":"p6be4204262c7-1","text":"旧香残粉似当初。"},{"id":"p4b5a06c57dd3-1","text":"人情恨不如。"},{"id":"pe6d1b3c9591a-1","text":"一春犹有数行书。"},{"id":"p92524d2c7d73-1","text":"秋来书更疏。"},{"id":"p240acd824599-1","text":"衾凤冷，枕鸳孤。"},{"id":"p95bdafc79a41-1","text":"愁肠待酒舒。"},{"id":"pdad571cd8bef-1","text":"梦魂纵有也成虚。"},{"id":"pe6fd08980d8b-1","text":"那堪和梦无。"}]}