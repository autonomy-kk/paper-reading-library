{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0070","paragraphs":[{"id":"p6ec34bcf3d81-1","text":"湘天风雨破寒初。"},{"id":"p2484ed5f9102-1","text":"深沈庭院虚。"},{"id":"pc024a48ea0d8-1","text":"丽谯吹罢《小单于》。"},{"id":"p7788aac3823b-1","text":"迢迢清夜徂。"},{"id":"pdcfd34703b7d-1","text":"乡梦断，旅魂孤。"},{"id":"pf3f71b239d9f-1","text":"峥嵘岁又除。"},{"id":"p7fdef6cdbcd0-1","text":"衡阳犹有雁传书。"},{"id":"p05b13ab3c862-1","text":"郴阳和雁无。"}]}