{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0140","paragraphs":[{"id":"pcb47dbe0fd2c-1","text":"碧云天，黄叶地。"},{"id":"pc4506995518f-1","text":"秋色连波，波上寒烟翠。"},{"id":"p3588fcd3f635-1","text":"山映斜阳天接水。"},{"id":"p09c360b84a62-1","text":"芳草无情，更在斜阳外。"},{"id":"pbba2349e18ed-1","text":"黯乡魂，追旅思。"},{"id":"pb5bac3220be4-1","text":"夜夜除非，好梦留人睡。"},{"id":"p410da0f98577-1","text":"明月楼高休独倚。"},{"id":"padead5f130b9-1","text":"酒入愁肠，化作相思泪。"}]}