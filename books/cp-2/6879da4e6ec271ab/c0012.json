{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0012","paragraphs":[{"id":"pa06f4395f5f8-1","text":"夜来雨。"},{"id":"pdcd84e87470a-1","text":"赖倩得、东风吹住。"},{"id":"p60c62db883a4-1","text":"海棠正妖饶处。"},{"id":"p279ac255b480-1","text":"且留取。"},{"id":"p98a9785bec0a-1","text":"悄庭户。"},{"id":"pd9968c3f3805-1","text":"试细听、莺啼燕语。"},{"id":"pe455e81284f1-1","text":"分明共人愁绪。"},{"id":"p7852e5512668-1","text":"怕春去。"},{"id":"pfa488ca7e68b-1","text":"佳树。"},{"id":"p28a309f9de51-1","text":"翠阴初转午。"},{"id":"pefd2c49d3ae9-1","text":"重帘未卷，乍睡起、寂寞看风絮。"},{"id":"p3b54b52204ad-1","text":"偷弹清泪寄烟波，见江头故人，为言憔悴如许。"},{"id":"p6b1ca951172c-1","text":"彩笺无数。"},{"id":"p293850f534e0-1","text":"去却寒暄，到了浑无定据。"},{"id":"p055c2ae122dc-1","text":"断肠落日千山暮。"}]}