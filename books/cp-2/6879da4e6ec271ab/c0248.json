{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0248","paragraphs":[{"id":"p3ab2cebf6b74-1","text":"泪湿阑干花著露。"},{"id":"p1c9c25f8ff89-1","text":"愁到眉峰碧聚。"},{"id":"p2edeb9ad02ee-1","text":"此恨平分取。"},{"id":"p775b77ccf7e5-1","text":"更无言语。"},{"id":"p73cacad47a87-1","text":"空相觑。"},{"id":"p9562ddafc2e0-1","text":"短雨残云无意绪。"},{"id":"p15b52f182045-1","text":"寂寞朝朝暮暮。"},{"id":"pc491e0b58b0f-1","text":"今夜山深处。"},{"id":"p987a60a3f0ae-1","text":"断魂分付。"},{"id":"p85c7144a70bb-1","text":"潮回去。"}]}