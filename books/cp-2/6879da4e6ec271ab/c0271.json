{"bookId":"cp-2","editionId":"6879da4e6ec271ab","chapterId":"c0271","paragraphs":[{"id":"pd19e2825c080-1","text":"赤阑桥尽香街直。"},{"id":"pa5a385fed5e9-1","text":"笼街细柳娇无力。"},{"id":"p4322476a5f10-1","text":"金碧上青空。"},{"id":"p29dfb7e58956-1","text":"花晴帘影红。"},{"id":"p84e65d9133dd-1","text":"黄衫飞白马。"},{"id":"p48478827b795-1","text":"日日青楼下。"},{"id":"p8ffbba2574bf-1","text":"醉眼不逢人。"},{"id":"p6b2a5c18778f-1","text":"午香吹暗尘。"}]}